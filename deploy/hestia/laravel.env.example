# .env of Laravel on api.dev.foodies.academy (Hestia user "jamper").
# Production (api.foodies.academy): the differences are listed in PRODUCTION.md.
# Copy to /home/jamper/web/api.dev.foodies.academy/public_html/.env and fill in the empty values.
# The deploy never overwrites this file.

APP_NAME=Foodies
APP_ENV=staging
# php8.3 artisan key:generate fills it in.
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.dev.foodies.academy

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info

# Laravel's own database (sessions, cache, API tokens). Hestia adds the user prefix "jamper_".
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=jamper_foodies_laravel
DB_USERNAME=jamper_foodies_laravel
DB_PASSWORD=

# The WordPress database the dev site works on: a copy, never the production one,
# because Laravel writes likes, views, searches and users into it.
SITE_DB_HOST=localhost
SITE_DB_PORT=3306
SITE_DB_DATABASE=jamper_foodies_site
SITE_DB_USERNAME=jamper_foodies_site
SITE_DB_PASSWORD=
SITE_DB_PREFIX=artit_
ACADEMY_UPLOADS_URL=https://foodies.academy/wp-content/uploads

# WordPress: user API, subscriptions (Contact Form 7). The key is the same as in wp-config-foodies.php.
WP_INTERNAL_URL=https://wp.dev.foodies.academy
FOODIES_API_SECRET=
# Contact Form 7 forms of the sign-ups (CFDB7 keeps each list apart): the newsletter and the
# free recipe book. Without CF7_BOOK_FORM_ID the book's sign-ups go to the newsletter form.
CF7_SUBSCRIBE_FORM_ID=77
CF7_BOOK_FORM_ID=

# Rebuild of dev.foodies.academy after content changes in WordPress (fine-grained token,
# repository jamperkostya/foodies-academy, "Contents: read and write").
GITHUB_DEPLOY_REPO=jamperkostya/foodies-academy
GITHUB_DEPLOY_TOKEN=
# Production: content-changed-production, so the build goes to foodies.academy.
GITHUB_DEPLOY_EVENT=content-changed

# Optional: YouTube Data API key for video statistics.
YOUTUBE_API_KEY=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=failover

MAIL_MAILER=log
