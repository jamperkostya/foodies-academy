APP_NAME=Foodies
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# On the server: LOG_STACK=daily,sentry, LOG_DAILY_DAYS=14, LOG_LEVEL=warning.
LOG_CHANNEL=stack
LOG_STACK=single,sentry
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laravel's own database: sessions, cache, tokens, queue (the "mysql" container; docker-compose sets the same).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=foodies_laravel
DB_USERNAME=laravel_user
DB_PASSWORD=

# The WordPress database of the site (prefix artit_): content, likes, views, users. Locally foodies_dev in MAMP,
# the same name as SITE_DB_DATABASE in the root .env. From Docker: the Mac's IPv4 in Docker Desktop;
# host.docker.internal resolves to IPv6 first, which MAMP doesn't listen on.
SITE_DB_HOST=192.168.65.254
SITE_DB_PORT=3306
SITE_DB_DATABASE=foodies_dev
SITE_DB_USERNAME=root
SITE_DB_PASSWORD=
SITE_DB_PREFIX=artit_
# SITE_DB_SOCKET=
# Images of recipes and posts.
ACADEMY_UPLOADS_URL=https://foodies.academy/wp-content/uploads

# WordPress as Laravel reaches it, and the key of its user API: the same as FOODIES_API_SECRET in the root .env
# (docker-compose passes both; these are for artisan outside Docker).
WP_INTERNAL_URL=http://wordpress
FOODIES_API_SECRET=
# Contact Form 7 forms of the sign-ups (post IDs, both required): the newsletter and the free recipe book.
CF7_SUBSCRIBE_FORM_ID=28089
CF7_BOOK_FORM_ID=77

# Site rebuilds through GitHub Actions (php artisan site:rebuild). Without the token they are only logged,
# which is what a local copy should do. Production: GITHUB_DEPLOY_EVENT=content-changed-production.
GITHUB_DEPLOY_REPO=jamperkostya/foodies-academy
GITHUB_DEPLOY_TOKEN=
GITHUB_DEPLOY_EVENT=content-changed

# YouTube videos (php artisan videos:sync). Without the API key only the 15 newest come, from RSS.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCR7s0mz-4hdJi_Y4BfiiogQ
YOUTUBE_AUTHOR_ID=1

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# failover: the database, or memory while it is down (tests/Feature/CacheTest.php)
CACHE_STORE=failover
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Error reporting (config/sentry.php); off without the DSN. Warnings and errors of the log come too
# (the "sentry" channel in LOG_STACK). No tracing: it would use up the free quota.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0
