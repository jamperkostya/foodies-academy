APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# The WordPress database of the site (prefix artit_): content, likes, views, users.
SITE_DB_HOST=host.docker.internal
SITE_DB_PORT=3306
SITE_DB_DATABASE=foodies.academy_with_content
SITE_DB_USERNAME=
SITE_DB_PASSWORD=
SITE_DB_PREFIX=artit_
# Images of recipes and posts.
ACADEMY_UPLOADS_URL=https://foodies.academy/wp-content/uploads

# WordPress as Laravel reaches it, and the key of its user API (the same as in WordPress).
WP_INTERNAL_URL=http://wordpress
FOODIES_API_SECRET=
# Contact Form 7 forms of the newsletter and the free recipe book sign-ups (post IDs, both required).
CF7_SUBSCRIBE_FORM_ID=77
CF7_BOOK_FORM_ID=

# Site rebuilds through GitHub Actions (empty: only logged).
GITHUB_DEPLOY_REPO=
GITHUB_DEPLOY_TOKEN=

# YouTube Data API for video statistics (optional).
YOUTUBE_API_KEY=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# failover: the database, or memory while it is down (tests/Feature/CacheTest.php)
CACHE_STORE=failover
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
