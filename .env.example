# Copy to .env. Shared by docker-compose services.
# Laravel calls the WordPress user API (wp-content/mu-plugins/foodies-users.php) with this key:
# any long random string, e.g. `openssl rand -hex 32`.
FOODIES_API_SECRET=

# Optional: start the production build (GitHub Actions) when WordPress content changes.
# A fine-grained token for the repository with "Contents: read and write".
GITHUB_DEPLOY_REPO=jamperkostya/foodies-academy
GITHUB_DEPLOY_TOKEN=

# WordPress database of the site in MAMP; the same name as SITE_DB_DATABASE in laravel-app/.env.
SITE_DB_DATABASE=foodies_dev
