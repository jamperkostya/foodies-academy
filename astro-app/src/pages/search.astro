---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import { langOf, t } from "../i18n";
const lang = langOf(Astro.url);
// The browser reports each search to Laravel, which saves it for Search Meter.
const PUBLIC_API_URL = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8000/api";
---
<BaseLayout bilingual noindex title={t(lang, "Поиск")} description={t(lang, "Поиск рецептов, категорий, кухонь мира и авторов на Foodies Academy.")} breadcrumbs={[{ label: t(lang, "Поиск") }]}>
	<Section>
		<Fragment slot="title"><span class="section-title__accent">{t(lang, "Результаты")}</span>{" "}{t(lang, "поиска")}</Fragment>
		<div class="search-results" data-log={`${PUBLIC_API_URL}/search-log`}>
			<p class="search-results__summary" aria-live="polite">{t(lang, "Введите запрос в строку поиска вверху страницы.")}</p>
			<ul class="search-results__list"></ul>
		</div>
	</Section>
</BaseLayout>

<style lang="less">
.search-results {
	max-width: 760px;
}

.search-results__summary {
	margin: 0 0 20px;
	font-size: 16px;
	line-height: 24px;
	color: var(--color-grey);
}

.search-results__list {
	display: grid;
	gap: 10px;
}

// Rendered by the script below, so they never get Astro's scoping attribute.
.search-results__list :global(.search-results__item) {
	display: flex;
	align-items: center;
	gap: 16px;
	padding: 16px 20px;
	border: var(--border-width) solid var(--color-black-10);
	border-radius: 20px;
	background: var(--color-white);
	font-size: 16px;
	line-height: 22px;
	transition: box-shadow .2s, transform .2s;
	&:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 24px var(--color-black-10);
	}
}

.search-results__list :global(.search-results__icon) {
	flex-shrink: 0;
	width: 36px;
	font-size: 24px;
	text-align: center;
}

.search-results__list :global(.search-results__title) {
	display: block;
	font-weight: 600;
}

.search-results__list :global(.search-results__match) {
	background: none;
	color: var(--color-red);
	font-weight: 700;
}

.search-results__list :global(.search-results__meta) {
	display: block;
	margin-top: 2px;
	font-size: 13px;
	color: var(--color-grey);
}
</style>

<script>
	import { pluralc, tc } from "../scripts/i18n";
	import { loadIndex, normalize, findItems, el, highlight } from "../scripts/search";

	const summary = document.querySelector<HTMLElement>(".search-results__summary");
	const list = document.querySelector<HTMLElement>(".search-results__list");
	const raw = (new URLSearchParams(window.location.search).get("q") ?? "").trim();
	const query = normalize(raw);

	const showResults = async (summary: HTMLElement, list: HTMLElement) => {
		summary.textContent = tc("Ищем…");
		const results = findItems(await loadIndex(), query);

		summary.textContent = results.length
			? tc("По запросу «{query}» {found} {n} {results}", { query: raw, found: pluralc(results.length, ["найден", "найдено", "найдено"]), n: results.length, results: pluralc(results.length, ["результат", "результата", "результатов"]) })
			: tc("Ничего не найдено по запросу «{query}»", { query: raw });

		list.replaceChildren(
			...results.map((result) => {
				const title = el("span", "search-results__title");
				title.append(...highlight(result.title, query, "search-results__match"));
				const text = el("span", "search-results__text");
				text.append(title, el("span", "search-results__meta", result.meta));

				const link = el("a", "search-results__item");
				link.href = result.href;
				link.append(el("span", "search-results__icon", result.icon), text);

				const item = document.createElement("li");
				item.append(link);
				return item;
			})
		);
		logSearch(results.length);
	};

	// Saved to Search Meter's statistics (WordPress admin → Dashboard → Search Meter).
	// Like Search Meter, only searches with a referrer count, so bots opening /search?q= don't.
	const logSearch = (hits: number) => {
		const url = document.querySelector<HTMLElement>(".search-results")?.dataset.log;
		if (!url || !document.referrer) return;
		fetch(url, {
			method: "POST",
			headers: { "Content-Type": "application/json", Accept: "application/json" },
			body: JSON.stringify({ q: raw, hits }),
			keepalive: true,
		}).catch(() => {});
	};

	if (summary && list && query) showResults(summary, list);
</script>
