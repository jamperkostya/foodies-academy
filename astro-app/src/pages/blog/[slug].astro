---
import ArticlePage from "../../components/article/ArticlePage.astro";
import type { Article } from "../../types/article";

const API_URL = import.meta.env.API_URL ?? "http://localhost:8000/api";

// One page per blog post (ordinary WordPress posts).
export async function getStaticPaths() {
	// getStaticPaths can't see the constants above, so the URL is read again here.
	const API_URL = import.meta.env.API_URL ?? "http://localhost:8000/api";
	const { data: slugs }: { data: string[] } = await fetch(`${API_URL}/blog/slugs`).then((r) => r.json());

	return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const response = await fetch(`${API_URL}/blog/${slug}`);
if (!response.ok) {
	throw new Error(`blog "${slug}" from ${API_URL}: HTTP ${response.status}`);
}
const { data: article }: { data: Article } = await response.json();
const { data: others }: { data: Article[] } = await fetch(`${API_URL}/blog?limit=20`).then((r) => r.json());
---
<ArticlePage article={article} others={others} section={{ label: "Блог", href: "/blog", api: "blog" }} />
