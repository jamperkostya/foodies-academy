---
import Section from "../../components/layout/Section.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RecipeHero from "../../components/sections/RecipeHero.astro";
import Icon from "../../components/ui/Icon.astro";
import Stars from "../../components/ui/Stars.astro";
import { recipes } from "../../data/recipes";
import type { Recipe } from "../../types/recipe";
import RecipeSection from "../../components/sections/RecipeSection.astro";

export function getStaticPaths() {
	return recipes.map((recipe) => ({ params: { slug: recipe.slug }, props: { recipe } }));
}

interface Props {
	recipe: Recipe;
}

const { recipe } = Astro.props;

const similarRecipes = recipes.filter((item) => item.isTop).slice(0, 10);
const sidebarRecipes = recipes.filter((item) => item.slug !== recipe.slug).slice(0, 3);

// Mock content until recipes come from the CMS. `base` is the quantity for
// 4 servings; the servings stepper rescales it on the client.
const ingredients = [
	{ base: 400, unit: "г", name: "спагетти" },
	{ base: 200, unit: "г", name: "гуанчале или панчетты" },
	{ base: 4, unit: "шт", name: "яичных желтка" },
	{ base: 1, unit: "шт", name: "яйцо целиком" },
	{ base: 100, unit: "г", name: "сыра Пекорино Романо, тёртого" },
	{ base: 50, unit: "г", name: "сыра Пармезан, тёртого" },
	{ base: 2, unit: "ч.л.", name: "свежемолотого чёрного перца" },
];

const steps = [
	"Доведите до кипения большую кастрюлю подсоленной воды и отварите спагетти до состояния al dente согласно инструкции на упаковке.",
	"Пока варится паста, нарежьте гуанчале небольшими кубиками около 1 см.",
	"Обжарьте гуанчале на среднем огне до золотистой корочки и вытапливания жира, 5–7 минут.",
	"В отдельной миске взбейте желтки, целое яйцо, тёртый пекорино и пармезан до однородной массы.",
	"Добавьте в яичную смесь щедрую порцию свежемолотого чёрного перца.",
	"Слейте пасту, обязательно оставив около 150 мл воды из-под пасты.",
	"Снимите сковороду с гуанчале с огня, добавьте горячую пасту и перемешайте, чтобы она впитала жир.",
	"Влейте яичную смесь, быстро перемешивая и подливая воду из-под пасты до кремовой консистенции. Подавайте немедленно с дополнительным сыром и перцем.",
];

const nutrition = [
	{ label: "Калории", value: "650 ккал" },
	{ label: "Белки", value: "28 г" },
	{ label: "Жиры", value: "32 г" },
	{ label: "Углеводы", value: "62 г" },
	{ label: "Клетчатка", value: "3 г" },
];

const ratingBars = [
	{ stars: 5, percent: 82 },
	{ stars: 4, percent: 12 },
	{ stars: 3, percent: 4 },
	{ stars: 2, percent: 1 },
	{ stars: 1, percent: 1 },
];

const reviews = [
	{ initials: "МК", name: "Мария К.", rating: 5, date: "28 июля 2026", text: "Готовила первый раз без сливок — получилось даже кремовее, чем я ожидала! Главное — снять сковороду с огня, как написано." },
	{ initials: "ДН", name: "Денис Н.", rating: 4, date: "15 июля 2026", text: "Очень вкусно, но в следующий раз добавлю чуть больше перца. Панчетту заменил на бекон — тоже отлично зашло." },
	{ initials: "АС", name: "Анна С.", rating: 5, date: "2 июля 2026", text: "Наконец рецепт, где паста не превращается в яичницу. Пекорино нашла с трудом, взяла половину пармезана — тоже хорошо." },
];

const starLabels = ["1 звезда", "2 звезды", "3 звезды", "4 звезды", "5 звёзд"];
---

<BaseLayout
	title={recipe.title}
	description={`${recipe.title}: рецепт с пошаговыми фото на Foodies Academy.`}
	breadcrumbs={[{ label: "Рецепты", href: "/categories" }, { label: recipe.title }]}>

	<RecipeHero slot="hero"></RecipeHero>

	<section class="recipe-quick-facts" slot="hero">
		<div class="recipe-quick-facts__inner container flex gap-10 items-center justify-between">
			<div class="quick-fact-item flex gap-10 items-center">
				<Icon name="clock" width={16} height={16} />
				<div class="quick-fact-item-data flex">
					<span class="quick-fact-item__value block">15 мин</span>
					<span class="quick-fact-item__description block">Подготовка</span>
				</div>
			</div>
			<div class="quick-fact-item flex gap-10 items-center">
				<Icon name="fire" width={18} height={18} />
				<div class="quick-fact-item-data flex">
					<span class="quick-fact-item__value block">45 мин</span>
					<span class="quick-fact-item__description block">Готовка</span>
				</div>
			</div>
			<div class="quick-fact-item flex gap-10 items-center">
				<Icon name="total" width={16} height={16} />
				<div class="quick-fact-item-data flex">
					<span class="quick-fact-item__value block">45 мин</span>
					<span class="quick-fact-item__description block">Всего</span>
				</div>
			</div>
			<div class="quick-fact-item flex gap-10 items-center">
				<Icon name="difficult" width={16} height={16} />
				<div class="quick-fact-item-data flex">
					<span class="quick-fact-item__value block">легко</span>
					<span class="quick-fact-item__description block">Сложность</span>
				</div>
			</div>
			<div class="quick-fact-item flex gap-10 items-center">
				<Icon name="kcal" width={24} height={24} />
				<div class="quick-fact-item-data flex">
					<span class="quick-fact-item__value block">650 ккал</span>
					<span class="quick-fact-item__description block">На порцию</span>
				</div>
			</div>
			<div class="quick-fact-item flex gap-10 items-center">
				<Icon name="profile" width={18} height={20} />
				<div class="quick-fact-item-data quick-fact-item__servings flex">
					<div class="servings-stepper flex gap-10 items-center">
						<button type="button" id="servingsMinus" aria-label="Уменьшить порции">−</button>
						<strong id="servingsValue" aria-live="polite">4</strong>
						<button type="button" id="servingsPlus" aria-label="Увеличить порции">+</button>
					</div>
					<span class="quick-fact-item__description block">Порции</span>
				</div>
			</div>
		</div>
	</section>

	<Section>
		<div class="recipe-layout grid gap-40">
			<div class="recipe-main">
				<article class="recipe-intro">
					<p>Карбонара — один из тех рецептов, где легко ошибиться и превратить пасту в омлет со спагетти. Весь секрет — снять сковороду с огня и вмешивать яичную смесь вне прямого жара, постоянно помешивая. Никаких сливок: кремовая текстура получается только за счёт эмульсии из яиц, сыра и крахмалистой воды из-под пасты.</p>
				</article>

				<div class="recipe-block" id="ingredients">
					<div class="recipe-block__head flex gap-15">
						<h2 class="recipe-block__title">Ингредиенты</h2>
						<span class="recipe-block__hint">на <span id="ingredientsServings">4</span> <span id="ingredientsServingsWord">порции</span></span>
					</div>

					<ul class="ingredient-list" id="ingredientList">
						{ingredients.map((item) => (
							<li class="ingredient-list__item" data-base={item.base} data-unit={item.unit}>
								<label class="ingredient-list__label">
									<input class="ingredient-list__checkbox" type="checkbox">
									<span class="ingredient-list__qty">{item.base} {item.unit}</span> {item.name}
								</label>
							</li>
						))}
						<li class="ingredient-list__item ingredient-list__item--note">
							<label class="ingredient-list__label">
								<input class="ingredient-list__checkbox" type="checkbox">
								<span>Соль — по вкусу</span>
							</label>
						</li>
					</ul>
				</div>

				<div class="recipe-block" id="instructions">
					<div class="recipe-block__head flex gap-15">
						<h2 class="recipe-block__title">Приготовление</h2>
						<span class="recipe-block__hint" id="stepsProgress">0 из {steps.length} шагов</span>
					</div>

					<ol class="step-list" id="stepList">
						{steps.map((step) => (
							<li class="step-list__item flex gap-10">
								<p class="step-list__text">{step}</p>
							</li>
						))}
					</ol>
				</div>

				<div class="tip-box flex gap-15 items-center">
					<span class="tip-box__icon flex-center">
						<Icon name="chef" width={24} height={24} />
					</span>
					<div class="tip-box__body">
						<strong class="tip-box__title">Совет от шефа</strong>
						<p class="tip-box__text">Снимайте сковороду с огня заранее — жар должен быть остаточным. Если яичная смесь попадёт на слишком горячую поверхность, вы получите варёные хлопья вместо кремового соуса.</p>
					</div>
				</div>

				<div class="recipe-block" id="nutrition">
					<div class="recipe-block__head flex gap-15">
						<h2 class="recipe-block__title">Пищевая ценность</h2>
						<span class="recipe-block__hint">на порцию</span>
					</div>
					<div class="nutrition-table">
						{nutrition.map((item) => (
							<div class="nutrition-table__row">{item.label}<strong class="nutrition-table__value">{item.value}</strong></div>
						))}
					</div>
				</div>

				<div class="recipe-block recipe-block--reviews" id="reviews">
					<div class="recipe-block__head flex gap-15">
						<h2 class="recipe-block__title">Отзывы</h2>
					</div>

					<div class="rating-summary flex gap-40 items-center">
						<div class="rating-summary__score">
							<strong class="rating-summary__value">4.8</strong>
							<Stars rating={4.8} />
							<span class="rating-summary__count">1 243 отзыва</span>
						</div>
						<div class="rating-summary__bars">
							{ratingBars.map((bar) => (
								<div class="rating-bar flex gap-10 items-center">
									<span class="rating-bar__label">{bar.stars}</span>
									<div class="rating-bar__track"><div class="rating-bar__fill" style={`width: ${bar.percent}%`}></div></div>
									<span class="rating-bar__percent">{bar.percent}%</span>
								</div>
							))}
						</div>
					</div>

					<form class="review-form" id="reviewForm" novalidate>
						<h3 class="review-form__title">Оставить отзыв</h3>
						<div class="review-form__rating flex gap-5" id="ratingInput" role="group" aria-label="Ваша оценка">
							{starLabels.map((label) => (
								<button type="button" class="review-form__star" aria-label={label} aria-pressed="false">★</button>
							))}
						</div>
						<input class="review-form__field" type="text" name="name" placeholder="Ваше имя" aria-label="Ваше имя" required>
						<textarea class="review-form__field" name="comment" rows="3" placeholder="Расскажите, как получился рецепт..." aria-label="Отзыв" required></textarea>
						<button type="submit" class="btn">Опубликовать отзыв</button>
					</form>

					<div class="review-list" id="reviewList">
						{reviews.map((review) => (
							<div class="review flex gap-15">
								<span class="avatar">{review.initials}</span>
								<div class="review__body">
									<div class="review__head flex gap-10 items-center">
										<strong class="review__name">{review.name}</strong>
										<Stars rating={review.rating} />
									</div>
									<span class="review__date">{review.date}</span>
									<p class="review__text">{review.text}</p>
								</div>
							</div>
						))}
					</div>

					{/* Cloned by the review form for each new review. */}
					<template id="reviewTemplate">
						<div class="review review--new flex gap-15">
							<span class="avatar"></span>
							<div class="review__body">
								<div class="review__head flex gap-10 items-center">
									<strong class="review__name"></strong>
									<Stars rating={0} />
								</div>
								<span class="review__date">Только что</span>
								<p class="review__text"></p>
							</div>
						</div>
					</template>
				</div>
			</div>

			<aside class="recipe-sidebar">
				<div class="author-card">
					<span class="avatar avatar--lg">SK</span>
					<strong class="author-card__name">Salad Konstantin</strong>
					<span class="author-card__info">Шеф-повар · 214 рецептов</span>
					<button type="button" class="btn btn--secondary author-card__btn">Подписаться</button>
				</div>

				<div class="sidebar-card">
					<h4 class="sidebar-card__title">Похожие рецепты</h4>
					<ul class="sidebar-mini-list">
						{sidebarRecipes.map((item) => (
							<li class="sidebar-mini-list__item">
								<a class="sidebar-mini-list__link flex gap-12 items-center" href={`/recipe/${item.slug}`}>
									<span class="sidebar-mini-list__img" style={`background-image: url('${item.image}')`}></span>
									<span>
										<strong class="sidebar-mini-list__title">{item.title}</strong>
										<small class="sidebar-mini-list__meta">{item.time} мин · {item.category}</small>
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>

				<div class="sidebar-card sidebar-card--newsletter">
					<h4 class="sidebar-card__title">Рецепт недели на почту</h4>
					<p class="sidebar-card__text">Раз в неделю — только лучшее, без спама.</p>
					<form class="sidebar-card__form" id="sidebarNewsletterForm">
						<input class="sidebar-card__input" type="email" placeholder="E-mail" aria-label="E-mail" required>
						<button type="submit" class="btn sidebar-card__btn">Подписаться</button>
					</form>
					<p class="sidebar-card__success" id="sidebarNewsletterSuccess" hidden><strong>Готово!</strong> Первый рецепт придёт в понедельник.</p>
				</div>
			</aside>
		</div>
	</Section>

	<div class="recipe-similar">
		<RecipeSection recipes={similarRecipes}>
			<Fragment slot="title">
				<span class="section-title__accent">Похожие</span> рецепты
			</Fragment>
		</RecipeSection>
	</div>

	<div class="toast" role="status" aria-live="polite"></div>
</BaseLayout>

<script>
	import "../../scripts/recipePage.ts";
</script>

<style lang="less">
.recipe-quick-facts {
	background: var(--color-white);
	border-bottom: var(--border-width) solid var(--color-border-search-form);
	padding: 10px 5px;
	.recipe-quick-facts__inner {
		flex-wrap: wrap;
		.quick-fact-item {
			.quick-fact-item-data {
				flex-wrap: wrap;
				.quick-fact-item__description, .quick-fact-item__value {
					width: 100%;
				}
				.quick-fact-item__value {
					font-weight: 700;
					font-size: 16px;
				}
				.quick-fact-item__description {
					color: var(--color-grey);
					text-transform: uppercase;
					letter-spacing: .5px;
					font-size: 10px;
				}
			}
			button {
				width: 26px;
				height: 26px;
				border-radius: var(--border-radius-1000);
				border: var(--border-width) solid var(--color-grey);
				background: var(--color-white);
				font-size: 16px;
				line-height: 1;
				font-weight: 700;
				color: var(--color-black);
				display: flex;
				align-items: center;
				justify-content: center;
				transition: background .15s, color .15s;
				&:hover {
					background: var(--color-red);
					color: var(--color-white);
					border-color: var(--color-red);
				}
			}
		}
	}
}

.recipe-layout {
	grid-template-columns: 1fr;
	align-items: start;
	@media @desktop {
		grid-template-columns: 1fr 320px;
	}
}

.recipe-intro {
	color: var(--color-grey-dark);
}

.recipe-block {
	margin-top: 30px;
	// Keeps the heading clear of the sticky header on anchor jumps.
	scroll-margin-top: 100px;
	&__head {
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 20px;
		border-bottom: 2px solid var(--color-black);
		padding-bottom: 12px;
	}
	&__title {
		font-size: 22px;
		text-transform: uppercase;
	}
	&__hint {
		font-size: 13px;
		font-weight: 600;
		color: var(--color-grey);
		white-space: nowrap;
	}
}

.ingredient-list {
	&__item {
		border-bottom: var(--border-width) solid var(--color-border-search-form);
		padding: 10px 5px;
		font-size: 14px;
		&.is-checked .ingredient-list__label {
			color: var(--color-grey);
			text-decoration: line-through;
		}
		&.is-checked .ingredient-list__qty {
			color: var(--color-grey);
		}
		&--note {
			font-style: italic;
		}
	}
	&__label {
		display: flex;
		align-items: center;
		gap: 12px;
		cursor: pointer;
		width: 100%;
	}
	&__checkbox {
		width: 20px;
		height: 20px;
		flex-shrink: 0;
		accent-color: var(--color-red);
		cursor: pointer;
	}
	&__qty {
		font-weight: 700;
		color: var(--color-red);
		min-width: 64px;
		display: inline-block;
	}
}

.step-list {
	counter-reset: step;
	&__item {
		margin-bottom: 5px;
		padding: 16px 8px;
		border-radius: var(--border-radius-25);
		cursor: pointer;
		user-select: none;
		transition: background .15s;
		&:hover {
			background: var(--color-gradient-violet);
		}
		&::before {
			counter-increment: step;
			content: counter(step);
			width: 34px;
			height: 34px;
			border-radius: var(--border-radius-50percents);
			background: var(--color-black);
			color: var(--color-white);
			font-weight: 800;
			font-size: 14px;
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
			transition: background .15s;
		}
		&.is-done::before {
			content: "✓";
			background: var(--color-red);
		}
		&.is-done .step-list__text {
			text-decoration: line-through;
			color: var(--color-grey);
		}
	}
	&__text {
		align-self: center;
	}
}

.tip-box {
	margin-top: 30px;
	background: var(--color-pink-20);
	padding: 15px 20px;
	border-radius: var(--border-radius-25);
	&__icon {
		width: 48px;
		height: 48px;
		flex-shrink: 0;
		border-radius: var(--border-radius-50percents);
		background: var(--color-white);
	}
	&__title {
		display: block;
		margin-bottom: 4px;
	}
	&__text {
		font-size: 14px;
		color: var(--color-grey-dark);
	}
}

.nutrition-table {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: 12px;
	@media @tablet {
		grid-template-columns: repeat(5, 1fr);
	}
	&__row {
		background: var(--color-light-grey);
		border-radius: var(--border-radius-10);
		padding: 16px 12px;
		text-align: center;
		color: var(--color-black-50);
		text-transform: uppercase;
		font-size: 12px;
	}
	&__value {
		font-size: 14px;
		display: block;
		color: var(--color-black);
	}
}

.rating-summary {
	flex-direction: column;
	align-items: flex-start;
	margin-bottom: 32px;
	@media @tablet {
		flex-direction: row;
		align-items: center;
	}
	&__score {
		text-align: center;
	}
	&__value {
		display: block;
		font-weight: 800;
		font-size: 40px;
		line-height: 1.2;
	}
	&__count {
		display: block;
		font-size: 12px;
		color: var(--color-grey);
		margin-top: 4px;
	}
	&__bars {
		flex: 1;
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
}

.rating-bar {
	font-size: 12px;
	color: var(--color-grey);
	&__track {
		flex: 1;
		height: 6px;
		border-radius: 4px;
		background: var(--color-light-grey);
		overflow: hidden;
	}
	&__fill {
		height: 100%;
		background: var(--color-red);
		border-radius: 4px;
	}
	&__percent {
		min-width: 32px;
		text-align: right;
	}
}

.review-form {
	background: var(--color-light-grey);
	border-radius: var(--border-radius-25);
	padding: 24px;
	margin-bottom: 32px;
	&__title {
		font-size: 16px;
		margin-bottom: 16px;
	}
	&__rating {
		margin-bottom: 14px;
	}
	&__star {
		background: none;
		border: none;
		font-size: 26px;
		line-height: 1;
		color: var(--color-grey);
		cursor: pointer;
		transition: color .1s, transform .1s;
		&:hover {
			transform: scale(1.15);
		}
		&.is-filled {
			color: var(--color-red);
		}
	}
	&__field {
		display: block;
		width: 100%;
		padding: 12px 16px;
		border-radius: var(--border-radius-10);
