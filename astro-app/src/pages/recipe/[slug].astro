---
import Section from "../../components/layout/Section.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleHero from "../../components/article/ArticleHero.astro";
import ArticleLayout from "../../components/article/ArticleLayout.astro";
import ContentBlock from "../../components/article/ContentBlock.astro";
import StepList from "../../components/article/StepList.astro";
import TipBox from "../../components/article/TipBox.astro";
import OriginStory from "../../components/article/OriginStory.astro";
import Reviews from "../../components/article/Reviews.astro";
import AuthorCard from "../../components/article/AuthorCard.astro";
import SidebarList from "../../components/article/SidebarList.astro";
import NewsletterCard from "../../components/article/NewsletterCard.astro";
import Icon from "../../components/ui/Icon.astro";
import Stars from "../../components/ui/Stars.astro";
import RecipeSection from "../../components/sections/RecipeSection.astro";

import type { Recipe } from "../../types/recipe";
import type { Review } from "../../types/review";
import { plural } from "../../utils/plural";
import { jsonLd } from "../../utils/jsonLd";

const API_URL = import.meta.env.API_URL ?? 'http://localhost:8000/api';

// One page per published recipe in Laravel.
export async function getStaticPaths() {
	// getStaticPaths can't see the constants above, so the URL is read again here.
	const API_URL = import.meta.env.API_URL ?? 'http://localhost:8000/api';
	const { data: slugs }: { data: string[] } = await fetch(`${API_URL}/recipes/slugs`).then((r) => r.json());

	return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const response = await fetch(`${API_URL}/recipes/${slug}`);
if (!response.ok) {
	throw new Error(`Recipe "${slug}" from ${API_URL}: HTTP ${response.status}`);
}
const { data: recipe }: { data: Recipe } = await response.json();

// { 257: "Вторые блюда" } → "Вторые блюда"
const course = Object.values(recipe.categories.course).join(', ');
const country = Object.values(recipe.categories.country).join(', ');

// Recipes sharing the most ingredients with this one (from Laravel); the top 3 also go to the sidebar.
const similarRecipes = recipe.similar ?? [];
const sidebarRecipes = similarRecipes.slice(0, 3).map((item) => ({
	title: item.title,
	meta: [item.time, ...Object.values(item.categories.course)].filter(Boolean).join(" · "),
	image: item.image,
	href: `/recipe/${item.slug}`,
}));

// Ingredients split by their group ("Для бульона", "Для зажарки"…), in recipe order.
// The servings stepper rescales every `quantity` on the client.
const ingredientGroups = Map.groupBy(recipe.ingredients, (item) => item.group);

// The group name ("ПРИГОТОВЛЕНИЕ ЛАНСПИКА") leads the first step of its group.
const steps = recipe.steps.map((step, i) => ({
	text: step.text,
	title: step.group && step.group !== recipe.steps[i - 1]?.group ? step.group : undefined,
}));

// Only what is filled in WordPress is shown.
const quickFacts = [
	{ icon: "clock", size: 16, value: recipe.prepTime, label: "Подготовка" },
	{ icon: "fire", size: 18, value: recipe.cookTime, label: "Готовка" },
	{ icon: "total", size: 16, value: recipe.time, label: "Всего" },
	{ icon: "difficult", size: 16, value: recipe.complexity, label: "Сложность" },
	{ icon: "kcal", size: 24, value: recipe.calories ? `${recipe.calories} ккал` : "", label: "На порцию" },
].filter((fact) => fact.value);

// Only calories are stored in WordPress; the block is hidden without them.
const nutrition = recipe.calories ? [{ label: "Калории", value: `${recipe.calories} ккал` }] : [];

const ratingBars = [
	{ stars: 5, percent: 82 },
	{ stars: 4, percent: 12 },
	{ stars: 3, percent: 4 },
	{ stars: 2, percent: 1 },
	{ stars: 1, percent: 1 },
];

const reviewsCount = `${recipe.comments.toLocaleString("ru-RU")} ${plural(recipe.comments, ["отзыв", "отзыва", "отзывов"])}`;
const description = `${recipe.title}: рецепт с пошаговыми фото на Foodies Academy.`;
// Recipes without servings in WordPress keep the old default of 4.
const servings = recipe.servings || 4;
const author = "Salad Konstantin";

const reviews: Review[] = recipe.reviews ?? [];
// The browser posts reviews straight to Laravel, so it needs the public URL,
// not the Docker-internal API_URL (http://laravel:8000).
const PUBLIC_API_URL = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8000/api";

// Recipe rich result in Google (rating, time, calories). Every value here is
// also shown on the page, as Google requires.
const recipeSchema = jsonLd({
	"@type": "Recipe",
	name: recipe.title,
	image: [recipe.image],
	description,
	author: { "@type": "Person", name: author },
	recipeCategory: course,
	recipeCuisine: country,
	totalTime: `PT${recipe.minutes}M`,
	recipeYield: `${servings} ${plural(servings, ["порция", "порции", "порций"])}`,
	nutrition: recipe.calories ? { "@type": "NutritionInformation", calories: `${recipe.calories} ккал` } : undefined,
	recipeIngredient: recipe.ingredients.map((item) => [item.amount, item.unit, item.name, item.notes].filter(Boolean).join(" ")),
	recipeInstructions: steps.map((step) => ({ "@type": "HowToStep", text: step.text })),
	aggregateRating: { "@type": "AggregateRating", ratingValue: recipe.rating, ratingCount: recipe.comments },
});
---

<BaseLayout
	title={recipe.title}
	description={description}
	breadcrumbs={[{ label: "Рецепты", href: "/categories" }, { label: recipe.title }]}>
	<script type="application/ld+json" is:inline set:html={recipeSchema} />

	<ArticleHero
		slot="hero"
		badge={course}
		label={country}
		title={recipe.title}
		description="Классическая римская паста без единой капли сливок: только яйца, панчетта, пекорино и много свежемолотого перца. Секрет кремового соуса — в технике, а не в лишних ингредиентах."
		image={recipe.image}
		anchor={{ href: "#ingredients", label: "Перейти к рецепту ↓" }}
		printable
	>
		<Fragment slot="meta">
			<Stars rating={recipe.rating} />
			<strong>{recipe.rating}</strong>
			<a href="#reviews" class="recipe-reviews-link">{reviewsCount}</a>
		</Fragment>
	</ArticleHero>

	<section class="recipe-quick-facts" slot="hero">
		<div class="recipe-quick-facts__inner container flex gap-10 items-center justify-between">
			{quickFacts.map((fact) => (
				<div class="quick-fact-item flex gap-10 items-center">
					<Icon name={fact.icon} width={fact.size} height={fact.size} />
					<div class="quick-fact-item-data flex">
						<span class="quick-fact-item__value block">{fact.value}</span>
						<span class="quick-fact-item__description block">{fact.label}</span>
					</div>
				</div>
			))}
			<div class="quick-fact-item flex gap-10 items-center">
				<Icon name="profile" width={18} height={20} />
				<div class="quick-fact-item-data quick-fact-item__servings flex">
					<div class="servings-stepper flex gap-10 items-center">
						<button type="button" class="no-print" id="servingsMinus" aria-label="Уменьшить порции">−</button>
						<strong id="servingsValue" aria-live="polite">{servings}</strong>
						<button type="button" class="no-print" id="servingsPlus" aria-label="Увеличить порции">+</button>
					</div>
					<span class="quick-fact-item__description block">Порции</span>
				</div>
			</div>
		</div>
	</section>

	<Section>
		<ArticleLayout>
			<p class="recipe-intro">Карбонара — один из тех рецептов, где легко ошибиться и превратить пасту в омлет со спагетти. Весь секрет — снять сковороду с огня и вмешивать яичную смесь вне прямого жара, постоянно помешивая. Никаких сливок: кремовая текстура получается только за счёт эмульсии из яиц, сыра и крахмалистой воды из-под пасты.</p>

			<ContentBlock title="Ингредиенты" id="ingredients">
				<span slot="hint" id="ingredientsServings">на {servings} {plural(servings, ["порцию", "порции", "порций"])}</span>
				<ul class="ingredient-list" id="ingredientList" data-servings={servings}>
					{[...ingredientGroups].map(([group, items]) => (
						<Fragment>
							{group && <li class="ingredient-list__group">{group}</li>}
							{items.map((item) => (
								<li class="ingredient-list__item" data-base={item.quantity ?? undefined} data-unit={item.unit}>
									<label class="ingredient-list__label">
										<input class="ingredient-list__checkbox" type="checkbox">
										<span class="ingredient-list__qty">{item.amount} {item.unit}</span>
										<span>{item.name}{item.notes && <span class="ingredient-list__notes"> {item.notes}</span>}</span>
									</label>
								</li>
							))}
						</Fragment>
					))}
				</ul>
			</ContentBlock>

			<ContentBlock title="Приготовление" id="instructions">
				<span slot="hint" id="stepsProgress">0 из {steps.length} шагов</span>
				<StepList steps={steps} progressId="stepsProgress" />
			</ContentBlock>

			<TipBox title="Совет от шефа">
				Снимайте сковороду с огня заранее — жар должен быть остаточным. Если яичная смесь попадёт на слишком горячую поверхность, вы получите варёные хлопья вместо кремового соуса.
			</TipBox>

			{nutrition.length > 0 && (
				<ContentBlock title="Пищевая ценность" id="nutrition">
					<span slot="hint">на порцию</span>
					<div class="nutrition-table">
						{nutrition.map((item) => (
							<div class="nutrition-table__row">{item.label}<strong class="nutrition-table__value">{item.value}</strong></div>
						))}
					</div>
				</ContentBlock>
			)}

			{recipe.history && <OriginStory html={recipe.history} />}

			<ContentBlock title="Отзывы" id="reviews" class="no-print">
				<div class="rating-summary flex gap-40 items-center">
					<div class="rating-summary__score">
						<strong class="rating-summary__value">{recipe.rating}</strong>
						<Stars rating={recipe.rating} />
						<span class="rating-summary__count">{reviewsCount}</span>
					</div>
					<div class="rating-summary__bars">
						{ratingBars.map((bar) => (
							<div class="rating-bar flex gap-10 items-center">
								<span class="rating-bar__label">{bar.stars}</span>
								<div class="rating-bar__track"><div class="rating-bar__fill" style={`width: ${bar.percent}%`}></div></div>
								<span class="rating-bar__percent">{bar.percent}%</span>
							</div>
						))}
					</div>
				</div>
				<Reviews
					reviews={reviews}
					withRating
					placeholder="Расскажите, как получился рецепт..."
					submitLabel="Опубликовать отзыв"
					successMessage="Спасибо! Отзыв появится после проверки модератором"
					action={`${PUBLIC_API_URL}/recipes/${recipe.slug}/comments`}
				/>
			</ContentBlock>

			<Fragment slot="sidebar">
				<AuthorCard name={author} info="Шеф-повар · 214 рецептов" buttonLabel="Подписаться" />
				<SidebarList title="Похожие рецепты" items={sidebarRecipes} />
				<NewsletterCard title="Рецепт недели на почту" />
			</Fragment>
		</ArticleLayout>
	</Section>

	<div class="no-print">
		<RecipeSection recipes={similarRecipes}>
			<Fragment slot="title">
				<span class="section-title__accent">Похожие</span> рецепты
			</Fragment>
		</RecipeSection>
	</div>
</BaseLayout>

<script>
	import "../../scripts/recipePage.ts";
</script>

<style lang="less">
.recipe-reviews-link {
	text-decoration: underline;
}

.recipe-quick-facts {
	background: var(--color-white);
	border-bottom: var(--border-width) solid var(--color-border-search-form);
	padding: 10px 5px;
	.recipe-quick-facts__inner {
		flex-wrap: wrap;
		.quick-fact-item {
			.quick-fact-item-data {
				flex-wrap: wrap;
				.quick-fact-item__description, .quick-fact-item__value {
					width: 100%;
				}
				.quick-fact-item__value {
					font-weight: 700;
					font-size: 16px;
				}
				.quick-fact-item__description {
					color: var(--color-grey);
					text-transform: uppercase;
					letter-spacing: .5px;
					font-size: 10px;
				}
			}
			button {
				width: 26px;
				height: 26px;
				border-radius: var(--border-radius-1000);
				border: var(--border-width) solid var(--color-grey);
				background: var(--color-white);
				font-size: 16px;
				line-height: 1;
				font-weight: 700;
				color: var(--color-black);
				display: flex;
				align-items: center;
				justify-content: center;
				transition: background .15s, color .15s;
				&:hover {
					background: var(--color-red);
					color: var(--color-white);
					border-color: var(--color-red);
				}
			}
		}
	}
}

.recipe-intro {
	color: var(--color-grey-dark);
}

.ingredient-list {
	&__item {
		border-bottom: var(--border-width) solid var(--color-border-search-form);
		padding: 10px 5px;
		font-size: 14px;
		&.is-checked .ingredient-list__label {
			color: var(--color-grey);
			text-decoration: line-through;
		}
		&.is-checked .ingredient-list__qty {
			color: var(--color-grey);
		}
		&--note {
			font-style: italic;
		}
	}
	&__group {
		padding: 16px 5px 6px;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: .5px;
		text-transform: uppercase;
		color: var(--color-grey);
	}
	&__notes {
		color: var(--color-grey);
	}
	&__label {
		display: flex;
		align-items: center;
		gap: 12px;
		cursor: pointer;
		width: 100%;
	}
	&__checkbox {
		width: 20px;
		height: 20px;
		flex-shrink: 0;
		accent-color: var(--color-red);
		cursor: pointer;
	}
	&__qty {
		font-weight: 700;
		color: var(--color-red);
		min-width: 64px;
		display: inline-block;
	}
}

.nutrition-table {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: 12px;
	@media @tablet {
		grid-template-columns: repeat(5, 1fr);
	}
	&__row {
		background: var(--color-light-grey);
		border-radius: var(--border-radius-10);
		padding: 16px 12px;
		text-align: center;
		color: var(--color-black-50);
		text-transform: uppercase;
		font-size: 12px;
	}
	&__value {
		font-size: 14px;
		display: block;
		color: var(--color-black);
	}
}

.rating-summary {
	flex-direction: column;
	align-items: flex-start;
	margin-bottom: 32px;
	@media @tablet {
		flex-direction: row;
		align-items: center;
	}
	&__score {
		text-align: center;
	}
	&__value {
		display: block;
		font-weight: 800;
		font-size: 40px;
		line-height: 1.2;
	}
	&__count {
		display: block;
		font-size: 12px;
		color: var(--color-grey);
		margin-top: 4px;
	}
	&__bars {
		flex: 1;
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
}

.rating-bar {
	font-size: 12px;
	color: var(--color-grey);
	&__track {
		flex: 1;
		height: 6px;
		border-radius: 4px;
		background: var(--color-light-grey);
		overflow: hidden;
	}
	&__fill {
		height: 100%;
		background: var(--color-red);
		border-radius: 4px;
	}
	&__percent {
		min-width: 32px;
		text-align: right;
	}
}
</style>
