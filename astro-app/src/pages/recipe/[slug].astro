---
import Section from "../../components/layout/Section.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleHero from "../../components/article/ArticleHero.astro";
import ArticleLayout from "../../components/article/ArticleLayout.astro";
import ContentBlock from "../../components/article/ContentBlock.astro";
import StepList from "../../components/article/StepList.astro";
import TipBox from "../../components/article/TipBox.astro";
import OriginStory from "../../components/article/OriginStory.astro";
import Reviews from "../../components/article/Reviews.astro";
import AuthorCard from "../../components/article/AuthorCard.astro";
import SidebarList from "../../components/article/SidebarList.astro";
import NewsletterCard from "../../components/article/NewsletterCard.astro";
import RecipeGallery from "../../components/article/RecipeGallery.astro";
import RecipeLikes from "../../components/article/RecipeLikes.astro";
import DonateCard from "../../components/article/DonateCard.astro";
import ViewCounter from "../../components/article/ViewCounter.astro";
import SEOTextSection from "../../components/sections/SEOTextSection.astro";
import Icon from "../../components/ui/Icon.astro";
import Stars from "../../components/ui/Stars.astro";
import RecipeSection from "../../components/sections/RecipeSection.astro";

import type { Recipe } from "../../types/recipe";
import type { Review } from "../../types/review";
import { jsonLd } from "../../utils/jsonLd";
import { builds, langOf, langOfRoute, LOCALES, localize, pluralOf, recipesWord, t, withLang, type Lang } from "../../i18n";
const lang = langOf(Astro.url);

const API_URL = import.meta.env.API_URL ?? 'http://localhost:8000/api';

// One page per published recipe in Laravel.
export async function getStaticPaths({ routePattern }: { routePattern?: string } = {}) {
	// Not built when only another language is rebuilt.
	if (!builds(langOfRoute(routePattern))) return [];
	// getStaticPaths can't see the constants above, so the URL is read again here.
	const API_URL = import.meta.env.API_URL ?? 'http://localhost:8000/api';
	const { data: slugs }: { data: string[] } = await fetch(withLang(langOfRoute(routePattern), `${API_URL}/recipes/slugs`)).then((r) => r.json());

	return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const response = await fetch(withLang(lang, `${API_URL}/recipes/${slug}`));
if (!response.ok) {
	throw new Error(`Recipe "${slug}" from ${API_URL}: HTTP ${response.status}`);
}
const { data: recipe }: { data: Recipe } = await response.json();

// { 257: "Вторые блюда" } → "Вторые блюда"
const course = Object.values(recipe.categories.course).join(', ');
const country = Object.values(recipe.categories.country).join(', ');

// Recipes sharing the most ingredients with this one (from Laravel); the top 3 also go to the sidebar.
const similarRecipes = recipe.similar ?? [];
const sidebarRecipes = similarRecipes.slice(0, 3).map((item) => ({
	title: item.title,
	meta: [item.time, ...Object.values(item.categories.course)].filter(Boolean).join(" · "),
	image: item.image,
	href: localize(lang, `/recipe/${item.slug}`),
}));

// Ingredients split by their group ("Для бульона", "Для зажарки"…), in recipe order.
// The servings stepper rescales every `quantity` on the client.
const ingredientGroups = Map.groupBy(recipe.ingredients, (item) => item.group);

// The group name ("ПРИГОТОВЛЕНИЕ ЛАНСПИКА") is a heading before the first step of its group.
const steps = recipe.steps.map((step, i) => ({
	text: step.text,
	group: step.group && step.group !== recipe.steps[i - 1]?.group ? step.group : undefined,
}));

// Only what is filled in WordPress is shown.
const quickFacts = [
	{ icon: "clock", size: 16, value: recipe.prepTime, label: t(lang, "Подготовка") },
	{ icon: "fire", size: 18, value: recipe.cookTime, label: t(lang, "Готовка") },
	{ icon: "total", size: 16, value: recipe.time, label: t(lang, "Всего") },
	{ icon: "difficult", size: 16, value: recipe.complexity, label: t(lang, "Сложность") },
	{ icon: "kcal", size: 24, value: recipe.calories ? t(lang, "{n} ккал", { n: recipe.calories }) : "", label: t(lang, "На порцию") },
].filter((fact) => fact.value);

// Only calories are stored in WordPress; the block is hidden without them.
const nutrition = recipe.calories ? [{ label: t(lang, "Калории"), value: t(lang, "{n} ккал", { n: recipe.calories }) }] : [];

// Star split from the reviews that have a rating; nothing to show without them.
const ratedReviews = (recipe.reviews ?? []).filter((review) => review.rating);
const ratingBars = ratedReviews.length
	? [5, 4, 3, 2, 1].map((stars) => ({
			stars,
			percent: Math.round((ratedReviews.filter((review) => review.rating === stars).length / ratedReviews.length) * 100),
		}))
	: [];
// No reviews and no star ratings: the rating summary is left out.
const hasRating = recipe.comments > 0 || ratedReviews.length > 0;

// Two or more photos, or a video recipe: the hero cover becomes a carousel.
const photos = recipe.gallery?.length ? recipe.gallery : [recipe.image];
const hasGallery = photos.length > 1 || Boolean(recipe.youtubeId);

const reviewsCount = `${recipe.comments.toLocaleString(LOCALES[lang])} ${pluralOf(lang, recipe.comments, [t(lang, "отзыв"), t(lang, "отзыва"), t(lang, "отзывов")])}`;
const description = t(lang, "{title}: рецепт с пошаговыми фото на Foodies Academy.", { title: recipe.title });
// Recipes without servings in WordPress keep the old default of 4.
const servings = recipe.servings || 4;

const reviews: Review[] = recipe.reviews ?? [];
// The browser posts reviews straight to Laravel, so it needs the public URL,
// not the Docker-internal API_URL (http://laravel:8000).
const PUBLIC_API_URL = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8000/api";

// Google's "keywords" are descriptors other than the dish type and cuisine, which have their own fields.
const keywords = [
	recipe.focusKeyword,
	recipe.complexity,
	recipe.minutes > 0 && recipe.minutes <= 30 ? t(lang, "быстрый рецепт") : "",
	recipe.youtubeId ? t(lang, "видеорецепт") : "",
].filter(Boolean);

// Recipe rich result in Google (rating, time, calories). Every value here is
// also shown on the page, as Google requires.
const recipeSchema = jsonLd({
	"@type": "Recipe",
	name: recipe.title,
	inLanguage: lang,
	image: photos,
	description,
	author: recipe.author ? { "@type": "Person", name: recipe.author.name } : undefined,
	recipeCategory: course,
	recipeCuisine: country,
	totalTime: `PT${recipe.minutes}M`,
	recipeYield: `${servings} ${pluralOf(lang, servings, [t(lang, "порция"), t(lang, "порции"), t(lang, "порций")])}`,
	nutrition: recipe.calories ? { "@type": "NutritionInformation", calories: t(lang, "{n} ккал", { n: recipe.calories }) } : undefined,
	recipeIngredient: recipe.ingredients.map((item) => [item.amount, item.unit, item.name, item.notes].filter(Boolean).join(" ")),
	recipeInstructions: steps.map((step) => ({ "@type": "HowToStep", text: step.text })),
	keywords: keywords.length ? keywords.join(", ") : undefined,
	video: recipe.youtubeId
		? {
				"@type": "VideoObject",
				name: recipe.title,
				description,
				thumbnailUrl: [`https://i.ytimg.com/vi/${recipe.youtubeId}/hqdefault.jpg`],
				uploadDate: recipe.updatedAt,
				embedUrl: `https://www.youtube.com/embed/${recipe.youtubeId}`,
				contentUrl: `https://www.youtube.com/watch?v=${recipe.youtubeId}`,
			}
		: undefined,
	// Google rejects a rating outside 1–5 or with ratingCount 0: reviews without stars give 0.
	aggregateRating: hasRating && recipe.rating >= 1 ? { "@type": "AggregateRating", ratingValue: recipe.rating, ratingCount: recipe.ratingCount || recipe.comments } : undefined,
});
---

<BaseLayout
	seo={recipe.seo}
	image={recipe.image}
	type="article"
	title={recipe.title}
	description={description}
	breadcrumbs={[{ label: t(lang, "Рецепты"), href: "/categories" }, { label: recipe.title }]}
	translations={Object.fromEntries(Object.entries(recipe.translations ?? {}).map(([code, slug]) => [code, localize(code as Lang, `/recipe/${slug}`)]))}>
	<script type="application/ld+json" is:inline set:html={recipeSchema} />

	<ArticleHero
		slot="hero"
		badge={course}
		label={country}
		title={recipe.title}
		description={recipe.description}
		image={recipe.image}
		withVideo={false}
		badgeLinks={recipe.categoryLinks?.course.map((term) => ({ name: term.name, href: `/category/${term.slug}` }))}
		labelLinks={recipe.categoryLinks?.country.map((term) => ({ name: term.name, href: `/category/${term.slug}` }))}
		anchor={{ href: "#ingredients", label: t(lang, "Перейти к рецепту ↓") }}
		printable
		flush
		favorite={{ slug: recipe.slug, id: recipe.id }}
	>
		{hasGallery && <RecipeGallery slot="media" title={recipe.title} photos={photos} youtubeId={recipe.youtubeId} />}
		<Fragment slot="meta">
			<Stars rating={recipe.rating} />
			<strong>{recipe.rating}</strong>
			<a href="#reviews" class="recipe-reviews-link">{reviewsCount}</a>
		</Fragment>
	</ArticleHero>

	<section class="recipe-quick-facts" slot="hero">
		<div class="recipe-quick-facts__inner container flex gap-10 items-center justify-between">
			{quickFacts.map((fact) => (
				<div class="quick-fact-item flex gap-10 items-center">
					<Icon name={fact.icon} width={fact.size} height={fact.size} />
					<div class="quick-fact-item-data flex">
						<span class="quick-fact-item__value block">{fact.value}</span>
						<span class="quick-fact-item__description block">{fact.label}</span>
					</div>
				</div>
			))}
			<div class="quick-fact-item flex gap-10 items-center">
				<Icon name="profile" width={18} height={20} />
				<div class="quick-fact-item-data quick-fact-item__servings flex">
					<div class="servings-stepper flex gap-10 items-center">
						<button type="button" class="no-print" id="servingsMinus" aria-label={t(lang, "Уменьшить порции")}>−</button>
						<strong id="servingsValue" aria-live="polite">{servings}</strong>
						<button type="button" class="no-print" id="servingsPlus" aria-label={t(lang, "Увеличить порции")}>+</button>
					</div>
					<span class="quick-fact-item__description block">{t(lang, "Порции")}</span>
				</div>
			</div>
		</div>
	</section>

	<Section>
		<ArticleLayout>
			<ContentBlock title={t(lang, "Ингредиенты")} id="ingredients">
				<span slot="hint" id="ingredientsServings">{t(lang, "на {n} {word}", { n: servings, word: pluralOf(lang, servings, ["порцию", "порции", "порций"]) })}</span>
				{/* English readers measure in metric or US units: the browser converts (scripts/recipePage.ts). */}
				{lang !== "ru" && (
					<div class="units-switch no-print" role="group" aria-label={t(lang, "Единицы измерения")}>
						<button type="button" class="units-switch__option" data-units="metric" aria-pressed="true">{t(lang, "Метрические")}</button>
						<button type="button" class="units-switch__option" data-units="us" aria-pressed="false">{t(lang, "США")}</button>
					</div>
				)}
				<ul class="ingredient-list" id="ingredientList" data-servings={servings} data-recipe={recipe.id}>
					{[...ingredientGroups].map(([group, items]) => (
						<Fragment>
							{group && <li class="ingredient-list__group">{group}</li>}
							{items.map((item) => (
								<li class="ingredient-list__item" data-base={item.quantity ?? undefined} data-unit={item.unit} data-code={item.unitCode ?? undefined}>
									<label class="ingredient-list__label">
										<input class="ingredient-list__checkbox" type="checkbox">
										<span class="ingredient-list__qty">{item.amount} {item.unit}</span>
										<span>{item.name}{item.notes && <span class="ingredient-list__notes"> {item.notes}</span>}</span>
									</label>
								</li>
							))}
						</Fragment>
					))}
				</ul>
			</ContentBlock>

			<ContentBlock title={t(lang, "Приготовление")} id="instructions">
				<span slot="hint" id="stepsProgress">{t(lang, "{done} из {total} шагов", { done: 0, total: steps.length })}</span>
				<StepList steps={steps} progressId="stepsProgress" />
			</ContentBlock>

			{recipe.tip && (
				<TipBox title={t(lang, "Совет от шефа")}>
					{/* HTML from our own WordPress (recipe_notes). */}
					<Fragment set:html={recipe.tip} />
				</TipBox>
			)}

			{nutrition.length > 0 && (
				<ContentBlock title={t(lang, "Пищевая ценность")} id="nutrition">
					<span slot="hint">{t(lang, "на порцию")}</span>
					<div class="nutrition-table">
						{nutrition.map((item) => (
							<div class="nutrition-table__row">{item.label}<strong class="nutrition-table__value">{item.value}</strong></div>
						))}
					</div>
				</ContentBlock>
			)}

			{recipe.history && <OriginStory html={recipe.history} />}

			<RecipeLikes slug={recipe.slug} votes={recipe.votes} action={withLang(lang, `${PUBLIC_API_URL}/recipes/${recipe.slug}/likes`)} />

			<DonateCard />

			<ContentBlock title={t(lang, "Отзывы")} id="reviews" class="no-print">
				{hasRating && (
					<div class="rating-summary flex gap-40 items-center">
						<div class="rating-summary__score">
							<strong class="rating-summary__value">{recipe.rating}</strong>
							<Stars rating={recipe.rating} />
							<span class="rating-summary__count">{reviewsCount}</span>
						</div>
						{ratingBars.length > 0 && (
							<div class="rating-summary__bars">
								{ratingBars.map((bar) => (
									<div class="rating-bar flex gap-10 items-center">
										<span class="rating-bar__label">{bar.stars}</span>
										<div class="rating-bar__track"><div class="rating-bar__fill" style={`width: ${bar.percent}%`}></div></div>
										<span class="rating-bar__percent">{bar.percent}%</span>
									</div>
								))}
							</div>
						)}
					</div>
				)}
				<Reviews
					reviews={reviews}
					withRating
					placeholder={t(lang, "Расскажите, как получился рецепт...")}
					submitLabel={t(lang, "Опубликовать отзыв")}
					successMessage={t(lang, "Спасибо! Отзыв появится после проверки модератором")}
					emptyText={t(lang, "Станьте первым, кто оставит комментарий для этого рецепта")}
					action={withLang(lang, `${PUBLIC_API_URL}/recipes/${recipe.slug}/comments`)}
				/>
			</ContentBlock>

			<Fragment slot="sidebar">
				{recipe.author && (
					<AuthorCard
						name={recipe.author.name}
						avatar={recipe.author.avatar}
						info={`${recipe.author.recipes.toLocaleString(LOCALES[lang])} ${recipesWord(lang, recipe.author.recipes)}`}
						buttonLabel={t(lang, "Профиль автора")}
						href={localize(lang, `/author/${recipe.author.slug}`)}
					/>
				)}
				<SidebarList title={t(lang, "Похожие рецепты")} items={sidebarRecipes} />
				<NewsletterCard title={t(lang, "Рецепт недели на почту")} />
			</Fragment>
		</ArticleLayout>
	</Section>

	<div class="no-print">
		<RecipeSection recipes={similarRecipes}>
			<Fragment slot="title">
				<span class="section-title__accent">{t(lang, "Похожие")}</span> {t(lang, "рецепты")}
			</Fragment>
		</RecipeSection>
	</div>

	<div class="no-print">
		<SEOTextSection html={recipe.seoText} />
	</div>

	<ViewCounter action={withLang(lang, `${PUBLIC_API_URL}/recipes/${recipe.slug}/view`)} />
</BaseLayout>

<script>
	import "../../scripts/recipePage.ts";
</script>

<style lang="less">
.recipe-reviews-link {
	text-decoration: underline;
}

.units-switch {
	display: inline-flex;
	gap: 4px;
	margin-bottom: 10px;
	padding: 3px;
	border-radius: var(--border-radius-25);
	background: var(--color-gradient-violet);
	&__option {
		padding: 6px 14px;
		border: 0;
		border-radius: var(--border-radius-25);
		background: transparent;
		font: inherit;
		font-size: 13px;
		font-weight: 700;
		cursor: pointer;
		&[aria-pressed="true"] {
			background: var(--color-black);
			color: var(--color-white);
		}
	}
}

.recipe-quick-facts {
	background: var(--color-white);
	border-bottom: var(--border-width) solid var(--color-border-search-form);
	padding: 10px 5px;
	.recipe-quick-facts__inner {
		flex-wrap: wrap;
		// Phones: one fact per row.
		@media @mobile {
			flex-direction: column;
			align-items: flex-start;
		}
		.quick-fact-item {
			// Value over label. A column, not wrapped 100%-wide rows: a wrapping row is as wide as
			// both lines side by side, which pushed the facts onto a second line on tablets.
			.quick-fact-item-data {
				flex-direction: column;
				.quick-fact-item__value {
					font-weight: 700;
					font-size: 16px;
				}
				.quick-fact-item__description {
					color: var(--color-grey);
					text-transform: uppercase;
					letter-spacing: .5px;
					font-size: 10px;
				}
			}
			button {
				width: 26px;
				height: 26px;
				border-radius: var(--border-radius-1000);
				border: var(--border-width) solid var(--color-grey);
				background: var(--color-white);
				font-size: 16px;
				line-height: 1;
				font-weight: 700;
				color: var(--color-black);
				display: flex;
				align-items: center;
				justify-content: center;
				transition: background .15s, color .15s;
				&:hover {
					background: var(--color-red);
					color: var(--color-white);
					border-color: var(--color-red);
				}
			}
		}
	}
}

.ingredient-list {
	&__item {
		border-bottom: var(--border-width) solid var(--color-border-search-form);
		padding: 10px 5px;
		font-size: 14px;
		&.is-checked .ingredient-list__label {
			color: var(--color-grey);
			text-decoration: line-through;
		}
		&.is-checked .ingredient-list__qty {
			color: var(--color-grey);
		}
		&--note {
			font-style: italic;
		}
	}
	&__group {
		padding: 16px 5px 6px;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: .5px;
		text-transform: uppercase;
		color: var(--color-grey);
	}
	&__notes {
		color: var(--color-grey);
	}
	&__label {
		display: flex;
		align-items: center;
		gap: 12px;
		cursor: pointer;
		width: 100%;
	}
	&__checkbox {
		width: 20px;
		height: 20px;
		flex-shrink: 0;
		accent-color: var(--color-red);
		cursor: pointer;
	}
	&__qty {
		font-weight: 700;
		color: var(--color-red);
		min-width: 64px;
		display: inline-block;
	}
}

.nutrition-table {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: 12px;
	@media @tablet {
		grid-template-columns: repeat(5, 1fr);
	}
	&__row {
		background: var(--color-light-grey);
		border-radius: var(--border-radius-10);
		padding: 16px 12px;
		text-align: center;
		color: var(--color-black-50);
		text-transform: uppercase;
		font-size: 12px;
	}
	&__value {
		font-size: 14px;
		display: block;
		color: var(--color-black);
	}
}

.rating-summary {
	flex-direction: column;
	align-items: flex-start;
	margin-bottom: 32px;
	@media @tablet {
		flex-direction: row;
		align-items: center;
	}
	&__score {
		text-align: center;
		// Phones: the score sits centred above the bars.
		@media @mobile {
			margin: auto;
		}
	}
	&__value {
		display: block;
		font-weight: 800;
		font-size: 40px;
		line-height: 1.2;
	}
	&__count {
		display: block;
		font-size: 12px;
		color: var(--color-grey);
		margin-top: 4px;
	}
	&__bars {
		flex: 1;
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
}

.rating-bar {
	font-size: 12px;
	color: var(--color-grey);
	&__track {
		flex: 1;
		height: 6px;
		border-radius: 4px;
		background: var(--color-light-grey);
		overflow: hidden;
	}
	&__fill {
		height: 100%;
		background: var(--color-red);
		border-radius: 4px;
	}
	&__percent {
		min-width: 32px;
		text-align: right;
	}
}
</style>
