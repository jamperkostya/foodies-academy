---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";

import { recipes } from '../data/recipes';
import { news } from '../data/news';
import { categories } from '../data/categories';
import { videos } from '../data/videos';

import RecipeSection from "../components/sections/RecipeSection.astro";
import CategorySection from "../components/sections/CategorySection.astro";
import VideoSection from "../components/sections/VideoSection.astro";
import LastNewsSection from "../components/sections/LastNewsSection.astro";

import RecipeCollectionsSection from "../components/sections/RecipeCollectionsSection.astro";

import PromoSection from "../components/sections/PromoSection.astro";
import PromoCTASection from "../components/sections/PromoCTASection.astro";

import SEOTextSection from "../components/sections/SEOTextSection.astro";

import TrustSection from "../components/sections/TrustSection.astro";

import SubscribeSection from "../components/sections/SubscribeSection.astro";

const topRecipes = recipes
	.filter((recipe) => recipe.isTop)
	.slice(0, 5);

const newRecipes = recipes.filter((recipe) => recipe.isNew);

// 1 featured (shown on the right) + 6 in the list on the left
const lastNews = news.slice(0, 7);
---

<BaseLayout>
	<Hero />

	<RecipeSection recipes={topRecipes}>
		<Fragment slot="title">
			<span class="section-title__accent">ТОП 5</span> рецептов
		</Fragment>
	</RecipeSection>

	<RecipeSection
		recipes={newRecipes}
		groupsOf={(recipe) => [recipe.category]}
		href="/recipes/new"
	>
		<Fragment slot="title">
			<span class="section-title__accent">Новые</span> рецепты
		</Fragment>
	</RecipeSection>
	
	<CategorySection categories={categories} href="/categories">
		<Fragment slot="title">
			<span class="section-title__accent">Популярные</span> категории
		</Fragment>
	</CategorySection>

	<VideoSection videos={videos} href="/video">
		<Fragment slot="title">
			<span class="section-title__accent">Видео</span>рецепты
		</Fragment>
	</VideoSection>
	
	<RecipeCollectionsSection>
		<Fragment slot="title">
			<span class="section-title__accent">Подборки</span> Рецептов
		</Fragment>
	</RecipeCollectionsSection>

	<RecipeSection
		recipes={recipes}
		groupsOf={(recipe) => recipe.ingredients}
		href="/recipes"
	>
		<Fragment slot="title">
			<span class="section-title__accent">Рецепты</span> по ингредиентам
		</Fragment>
	</RecipeSection>
	
	<PromoSection />
	
	<LastNewsSection
		news={lastNews}
	>
		<Fragment slot="title">
			<span class="section-title__accent">Последние</span> новости
		</Fragment>
	</LastNewsSection>
	
	<PromoCTASection />
	
	<TrustSection>
		<Fragment slot="title">
			Нам <span class="section-title__accent">доверяют</span>
		</Fragment>
	</TrustSection>
	
	<SubscribeSection />
	
	<SEOTextSection />
</BaseLayout>
