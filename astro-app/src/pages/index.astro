---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
---

<BaseLayout>
	<main role="main" class="container">
		<Hero />

		<section class="section--item section--cream">
			<h2 class="section--title"><span>TOP 5</span> RECIPES</h2>
		</section>

		<section class="section--item section--cream">
			<h2 class="section--title"><span>New</span> RECIPES</h2>
		</section>

		<section class="section--item section--cream">
			<h2 class="section--title"><span>Best</span> categories</h2>
		</section>

		<section class="section--item section--cream">
			<h2 class="section--title"><span>top 5</span> video</h2>
		</section>

		<section class="section--item section--cream">
			<h2 class="section--title"><span>Подборки</span> Рецептов</h2>
		</section>

		<section class="section--item section--cream">
			<h2 class="section--title"><span>Рецепты</span> по ингредиентам</h2>
		</section>

		<section class="section--item section--cream">
			<h2 class="section--title"><span>Последние</span> новости</h2>
		</section>
	</main>
</BaseLayout>
