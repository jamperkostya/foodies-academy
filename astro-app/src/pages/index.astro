---
import BaseLayout from "../layouts/BaseLayout.astro";

import Hero from "../components/sections/Hero.astro";

import { recipes } from '../data/recipes';
const API_URL = import.meta.env.API_URL ?? 'http://localhost:8000/api';
const { data: topRecipes } = await fetch(`${API_URL}/recipes/top?limit=5`).then(r => r.json());
const { data: featuredRecipes } = await fetch(`${API_URL}/recipes/featured?limit=10`).then(r => r.json());
const { data: ingredientRecipes } = await fetch(`${API_URL}/recipes/by-ingredients?ingredients=5&limit=20`).then(r => r.json());
// The 30 newest recipes, filtered by dish type on the page.
const { data: newRecipes } = await fetch(`${API_URL}/recipes/new?limit=30`).then(r => r.json());

const { data: popularCategories } = await fetch(`${API_URL}/categories/popular?type=course&limit=10`).then(r => r.json());
// Newest video recipes (imported from YouTube into WordPress).
const { data: { videos } } = await fetch(`${API_URL}/videos?per_page=10`).then(r => r.json());

import RecipeSection from "../components/sections/RecipeSection.astro";
import CategorySection from "../components/sections/CategorySection.astro";
import VideoSection from "../components/sections/VideoSection.astro";
import LastNewsSection from "../components/sections/LastNewsSection.astro";

import RecipeCollectionsSection from "../components/sections/RecipeCollectionsSection.astro";

import PromoSection from "../components/sections/PromoSection.astro";
import PromoCTASection from "../components/sections/PromoCTASection.astro";

import SEOTextSection from "../components/sections/SEOTextSection.astro";
import { wpPage } from "../utils/wpPage";

// "SEO-текст" and Yoast SEO of the WordPress page "home".
const { seoText, seo } = await wpPage("home");
// The two promo blocks are WordPress pages: title, excerpt and image are edited in the admin.
const [getStartedPage, ingredientGuidePage] = await Promise.all(
	["get-started", "ingredient-guide"].map((slug) => fetch(`${API_URL}/pages/${slug}`).then((r) => r.json()).then((r) => r.data)),
);

import TrustSection from "../components/sections/TrustSection.astro";

import SubscribeSection from "../components/sections/SubscribeSection.astro";

// 1 featured (shown on the right) + 6 in the list on the left
const { data: lastNews } = await fetch(`${API_URL}/news?limit=4`).then(r => r.json());
// The home grid has 4 columns, so the first 4 here; the footer lists them all.
const { data: allCollections } = await fetch(`${API_URL}/collections`).then(r => r.json());
const collections = allCollections.slice(0, 4);
---

<BaseLayout seo={seo}>
	<Hero recipes={featuredRecipes} />

	<RecipeSection recipes={topRecipes}>
		<Fragment slot="title">
			<span class="section-title__accent">ТОП 5</span> рецептов
		</Fragment>
	</RecipeSection>

	<RecipeSection
		recipes={newRecipes}
		groupsOf={(recipe) => Object.values(recipe.categories.course)}
		href="/categories"
	>
		<Fragment slot="title">
			<span class="section-title__accent">Новые</span> рецепты
		</Fragment>
	</RecipeSection>
	
	<CategorySection categories={popularCategories} href="/categories">
		<Fragment slot="title">
			<span class="section-title__accent">Популярные</span> категории
		</Fragment>
	</CategorySection>

	<VideoSection videos={videos} href="/video">
		<Fragment slot="title">
			<span class="section-title__accent">Видео</span>рецепты
		</Fragment>
	</VideoSection>
	
	<RecipeCollectionsSection collections={collections}>
		<Fragment slot="title">
			<span class="section-title__accent">Подборки</span> Рецептов
		</Fragment>
	</RecipeCollectionsSection>

	<RecipeSection
		recipes={ingredientRecipes}
		groupsOf={(recipe) => recipe.groups ?? []}
		href="/categories"
	>
		<Fragment slot="title">
			<span class="section-title__accent">Рецепты</span> по ингредиентам
		</Fragment>
	</RecipeSection>
	
	<PromoSection page={getStartedPage} />
	
	{/* News (post type "news") — the block appears once there is some. */}
	{lastNews.length > 0 && (
		<LastNewsSection
			news={lastNews}
		>
			<Fragment slot="title">
				<span class="section-title__accent">Последние</span> новости
			</Fragment>
		</LastNewsSection>
	)}
	
	<PromoCTASection page={ingredientGuidePage} />
	
	<TrustSection>
		<Fragment slot="title">
			Нам <span class="section-title__accent">доверяют</span>
		</Fragment>
	</TrustSection>
	
	<SubscribeSection />
	
	<SEOTextSection html={seoText} />
</BaseLayout>
