---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/ui/Icon.astro";
import Stars from "../components/ui/Stars.astro";
---

<BaseLayout>
	<main role="main" class="container">
		<section class="hero section--item">
			<div class="carousel carousel--hero">
				<div class="hero__grid is-draggable" id="heroGrid">
					<div class="hero__page">
						<a href="#11" class="hero-card hero-card--tall">
							<div class="hero-card__img" style="background-image:url('https://foodies.academy/wp-content/uploads/2018/09/DSC00328-300x300.jpg')"></div>
							<div class="hero-card__top flex flex-between">
								<button class="play-badge" id="video-id-41"><Icon name="youtube-play" width={42} height={29} /></button>
								<div class="hero-card__stats gap-12 grid">
									<div class="flex gap-12 flex-center">
										<span class="views flex gap-3"><Icon name="views" width={16} height={16} />1034</span>
										<span class="likes flex gap-3"><Icon name="like" width={16} height={16} />771</span>
									</div>
									<div class="hero-card__rating flex gap-5 flex-center">
										<span class="flex gap-3"><Icon name="comment" width={16} height={16} />2</span>
										<Stars rating={1.3} />
									</div>
								</div>
							</div>
							<div class="hero-card__title">Мидии с чоризо в томатном соусе</div>
						</a>
						
						<div class="hero__stack">
							<a href="#" class="hero-card hero-card--half">
								<div class="hero-card__img" style="background-image:url('https://foodies.academy/wp-content/uploads/2025/10/zamachau-sous-300x300.webp')"></div>
								<div class="hero-card__stats gap-12 grid">
									<div class="flex gap-12 flex-center">
										<span class="views flex gap-3"><Icon name="views" width={16} height={16} />1034</span>
										<span class="likes flex gap-3"><Icon name="like" width={16} height={16} />771</span>
									</div>
									<div class="hero-card__rating flex gap-5 flex-center">
										<span class="flex gap-3"><Icon name="comment" width={16} height={16} />2</span>
										<Stars rating={4.5} />
									</div>
								</div>
								<div class="hero-card__title">Паэлья с морепродуктами</div>
							</a>
							
							<a href="#" class="hero-card hero-card--half">
								<div class="hero-card__img" style="background-image:url('https://foodies.academy/wp-content/uploads/2018/09/DSC00683-300x300.jpg')"></div>
								<div class="hero-card__stats gap-12 grid">
									<div class="flex gap-12 flex-center">
										<span class="views flex gap-3"><Icon name="views" width={16} height={16} />134</span>
										<span class="likes flex gap-3"><Icon name="like" width={16} height={16} />71</span>
									</div>
									<div class="hero-card__rating flex gap-5 flex-center">
										<span class="flex gap-3"><Icon name="comment" width={16} height={16} />112</span>
										<Stars rating={4.5} />
									</div>
								</div>
								<div class="hero-card__title">Мидии с чоризо в томатном соусе</div>
							</a>
						</div>
						
						<a href="#11" class="hero-card hero-card--tall">
							<div class="hero-card__img" style="background-image:url('https://foodies.academy/wp-content/uploads/2018/09/DSC00328-300x300.jpg')"></div>
							<div class="hero-card__top flex flex-between">
								<button class="play-badge" id="video-id-41"><Icon name="youtube-play" width={42} height={29} /></button>
								<div class="hero-card__stats gap-12 grid">
									<div class="hero-card__stats gap-12 grid">
										<div class="flex gap-12 flex-center">
											<span class="views flex gap-3"><Icon name="views" width={16} height={16} />1034</span>
											<span class="likes flex gap-3"><Icon name="like" width={16} height={16} />771</span>
										</div>
										<div class="hero-card__rating flex gap-5 flex-center">
											<span class="flex gap-3"><Icon name="comment" width={16} height={16} />2</span>
											<Stars rating={4.1} />
										</div>
									</div>
								</div>
							</div>
							<div class="hero-card__title">Мидии с чоризо в томатном соусе</div>
						</a>
					</div>
					<button class="hero__arrow hero__arrow--prev" aria-label="Назад">
						<Icon name="arrow-slider" width={12} height={10} />
					</button>
					<button class="hero__arrow hero__arrow--next" aria-label="Вперёд">
						<Icon name="arrow-slider" width={12} height={10} />
					</button>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>
<style lang="less">
	@import "./index.less";
</style>