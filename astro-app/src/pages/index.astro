---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";

import { recipes } from '../data/recipes';
import { news } from '../data/news';

import RecipeSection from "../components/sections/RecipeSection.astro";
import LastNewsSection from "../components/sections/LastNewsSection.astro";

import RecipeCollestionsSection from "../components/sections/RecipeCollections.astro";

const topRecipes = recipes
	.filter((recipe) => recipe.isTop)
	.slice(0, 10);
	
// 1 featured (shown on the right) + 6 in the list on the left
const lastNews = news.slice(0, 7);
---

<BaseLayout>
	<main role="main" class="container">
		<Hero />
		
		<RecipeSection
			recipes={topRecipes}
			href="/recipes/top"
			trackId="top5Recipes"
		>
			<Fragment slot="title">
				<span>TOP 5</span> RECIPES
			</Fragment>
		</RecipeSection>

		<RecipeSection
			recipes={topRecipes}
			href="/recipes/top"
		>
			<Fragment slot="title">
				<span>New</span> RECIPES
			</Fragment>
		</RecipeSection>
		
		<RecipeSection
			recipes={topRecipes}
			href="/recipes/top"
		>
			<Fragment slot="title">
				<span>TOP 5</span> RECIPES
			</Fragment>
		</RecipeSection>
		
		<RecipeSection
			recipes={topRecipes}
			href="/recipes/top"
		>
			<Fragment slot="title">
				<span>TOP 5</span> RECIPES
			</Fragment>
		</RecipeSection>
		
		<RecipeSection
			recipes={topRecipes}
			href="/recipes/top"
		>
			<Fragment slot="title">
				<span>TOP 5</span> RECIPES
			</Fragment>
		</RecipeSection>

		<section class="section--item">
			<h2 class="section--title"><span>Best</span> categories</h2>
		</section>

		<section class="section--item">
			<h2 class="section--title"><span>top 5</span> video</h2>
		</section>
		
		<RecipeCollestionsSection>
			<Fragment slot="title">
				<span>Подборки</span> Рецептов
			</Fragment>
		</RecipeCollestionsSection>

		<RecipeSection
			recipes={topRecipes}
			href="/recipes/top"
		>
			<Fragment slot="title">
				<span>Рецепты</span> по ингредиентам
			</Fragment>
		</RecipeSection>
		
		<LastNewsSection
			news={lastNews}
		>
			<Fragment slot="title">
				<span>Last</span> news
			</Fragment>
		</LastNewsSection>
	</main>
</BaseLayout>
