---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";

import { recipes } from '../data/recipes';
import { news } from '../data/news';
import { categories } from '../data/categories';

import RecipeSection from "../components/sections/RecipeSection.astro";
import CategorySection from "../components/sections/CategorySection.astro";
import LastNewsSection from "../components/sections/LastNewsSection.astro";

import RecipeCollestionsSection from "../components/sections/RecipeCollections.astro";

import PromoSection from "../components/sections/PromoSection.astro";
import PromoCTASection from "../components/sections/PromoCTASection.astro";

import SEOTextSection from "../components/sections/SEOTextSection.astro";

import TrustSection from "../components/sections/TrustSection.astro";

const topRecipes = recipes
	.filter((recipe) => recipe.isTop)
	.slice(0, 10);
	
// 1 featured (shown on the right) + 6 in the list on the left
const lastNews = news.slice(0, 7);
---

<BaseLayout>
	<main role="main" class="container">
		<Hero />
				
		<RecipeSection
			recipes={topRecipes}
			href="/recipes/top"
			trackId="top5Recipes"
		>
			<Fragment slot="title">
				<span>TOP 5</span> RECIPES
			</Fragment>
		</RecipeSection>

		<RecipeSection
			recipes={topRecipes}
			href="/recipes/top"
		>
			<Fragment slot="title">
				<span>New</span> RECIPES
			</Fragment>
		</RecipeSection>
		
		<RecipeSection
			recipes={topRecipes}
			href="/recipes/top"
		>
			<Fragment slot="title">
				<span>TOP 5</span> RECIPES
			</Fragment>
		</RecipeSection>
		
		<RecipeSection
			recipes={topRecipes}
			href="/recipes/top"
		>
			<Fragment slot="title">
				<span>TOP 5</span> RECIPES
			</Fragment>
		</RecipeSection>
		
		<RecipeSection
			recipes={topRecipes}
			href="/recipes/top"
		>
			<Fragment slot="title">
				<span>TOP 5</span> RECIPES
			</Fragment>
		</RecipeSection>
		
		<CategorySection categories={categories}>
			<Fragment slot="title">
				<span>BEST</span> categories
			</Fragment>
		</CategorySection>

		<section class="section-item">
			<h2 class="section-title"><span>top 5</span> video</h2>
		</section>
		
		<RecipeCollestionsSection>
			<Fragment slot="title">
				<span>Подборки</span> Рецептов
			</Fragment>
		</RecipeCollestionsSection>

		<RecipeSection
			recipes={topRecipes}
			href="/recipes/top"
		>
			<Fragment slot="title">
				<span>Рецепты</span> по ингредиентам
			</Fragment>
		</RecipeSection>
		
		<PromoSection>
		</PromoSection>
		
		<LastNewsSection
			news={lastNews}
		>
			<Fragment slot="title">
				<span>Last</span> news
			</Fragment>
		</LastNewsSection>
		
		<PromoCTASection>
		</PromoCTASection>
		
		<TrustSection>
			<Fragment slot="title">
				<span>Trust</span> us
			</Fragment>
		</TrustSection>
		
		<SEOTextSection>
		</SEOTextSection>
	</main>
</BaseLayout>
