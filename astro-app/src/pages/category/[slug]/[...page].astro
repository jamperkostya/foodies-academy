---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/layout/PageHero.astro";
import SortBar from "../../../components/ui/SortBar.astro";
import CardGrid from "../../../components/ui/CardGrid.astro";
import RecipeCard from "../../../components/recipes/RecipeCard.astro";
import { recipesWord } from "../../../utils/plural";
import Pagination from "../../../components/ui/Pagination.astro";
import { pageHref, pageNumber, pageParams } from "../../../utils/pagination";
import type { Category } from "../../../types/category";
import type { Recipe } from "../../../types/recipe";
import SEOTextSection from "../../../components/sections/SEOTextSection.astro";

const API_URL = import.meta.env.API_URL ?? "http://localhost:8000/api";

// Every dish type and country with recipes, split into pages of 24 recipes.
export async function getStaticPaths() {
	// getStaticPaths can't see the constants above, so the URL is read again here.
	const API_URL = import.meta.env.API_URL ?? "http://localhost:8000/api";
	const load = async (type: string): Promise<Category[]> =>
		(await fetch(`${API_URL}/categories?type=${type}`).then((r) => r.json())).data;
	const categories = [...(await load("course")), ...(await load("country"))];

	return categories.flatMap((category) =>
		pageParams(category.count).map((page) => ({ params: { slug: category.slug, page } })),
	);
}

const { slug } = Astro.params;
const page = pageNumber(Astro.params.page);
const response = await fetch(`${API_URL}/categories/${slug}?page=${page}`);
if (!response.ok) {
	throw new Error(`Category "${slug}" from ${API_URL}: HTTP ${response.status}`);
}
const { data: category }: { data: Category & { recipes: Recipe[]; total: number; pages: number } } = await response.json();
const categoryRecipes = category.recipes;

// A country page sits under "Кухни мира", a dish type under "Категории".
const parent = category.type === "country"
	? { label: "Кухни мира", href: "/kitchens", eyebrow: "Кухня мира" }
	: { label: "Категории", href: "/categories", eyebrow: "Категория" };
const description = `${category.count.toLocaleString("ru-RU")} ${recipesWord(category.count)} с пошаговыми фото.`;
// "popular" keeps the data's own order.
const sortOptions = [
	{ value: "popular", label: "По популярности" },
	{ value: "az", label: "По алфавиту" },
];
---
<BaseLayout
	title={`${category.name}${page > 1 ? ` — страница ${page}` : ""}`}
	description={`${category.name}: рецепты с пошаговыми фото на Foodies Academy.`}
	breadcrumbs={[{ label: parent.label, href: parent.href }, { label: category.name }]}>
	<PageHero slot="hero" eyebrow={parent.eyebrow} description={description}>
		<span class="page-hero__accent">{category.name}</span>
	</PageHero>
	
	<section class="catalog section-item">
		<SortBar
			count={category.total}
			countWord={recipesWord(category.total)}
			options={sortOptions}
		/>
		{categoryRecipes.length ? (
			<CardGrid minCardWidth={260}>
				{categoryRecipes.map((recipe) => <RecipeCard recipe={recipe} />)}
			</CardGrid>
			<Pagination page={page} pages={category.pages} base={`/category/${slug}`} />
		) : (
			<p class="category-empty">В этой категории пока нет рецептов.</p>
		)}
	</section>
	<SEOTextSection />
</BaseLayout>

<style lang="less">
.catalog {
	padding-top: 25px;
}

.category-empty {
	font-size: 16px;
	line-height: 24px;
	color: var(--color-grey);
}
</style>

<script>
	// Sorting only reorders the cards already on the page.
	const catalog = document.querySelector<HTMLElement>(".catalog");
	const select = catalog?.querySelector<HTMLSelectElement>(".sort-bar__field");
	const grid = catalog?.querySelector<HTMLElement>(".card-grid");

	if (select && grid) {
		// In page order; "Показать ещё" adds the next page's cards (see Pagination).
		const cards = [...grid.querySelectorAll<HTMLElement>(".recipe-card")];
		const title = (card: HTMLElement) => card.querySelector(".recipe-card__title")?.textContent ?? "";

		const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
			az: (a, b) => title(a).localeCompare(title(b), "ru"),
		};

		const sort = () => {
			const sorter = sorters[select.value];
			grid.append(...(sorter ? [...cards].sort(sorter) : cards));
		};
		select.addEventListener("change", sort);
		grid.addEventListener("cards:loaded", (event) => {
			cards.push(...(event as CustomEvent<HTMLElement[]>).detail);
			sort();
		});
	}
</script>
