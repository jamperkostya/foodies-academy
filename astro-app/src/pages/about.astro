---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/layout/PageHero.astro";
import Section from "../components/layout/Section.astro";
import SubscribeSection from "../components/sections/SubscribeSection.astro";
import { plural, recipesWord } from "../utils/plural";

// Text from https://foodies.academy/about. The numbers come from Laravel,
// so they always match the catalogue.
const API_URL = import.meta.env.API_URL ?? "http://localhost:8000/api";
const load = async (path: string): Promise<unknown[]> => (await fetch(`${API_URL}${path}`).then((r) => r.json())).data;
const [recipes, kitchens, courses] = await Promise.all([
	load("/recipes/slugs"),
	load("/categories?type=country"),
	load("/categories?type=course"),
]);

const stats = [
	{ value: recipes.length, label: recipesWord(recipes.length) },
	{ value: kitchens.length, label: `${plural(kitchens.length, ["кухня", "кухни", "кухонь"])} мира` },
	{ value: courses.length, label: plural(courses.length, ["тип блюд", "типа блюд", "типов блюд"]) },
];

const description =
	"Платформа обучения и вдохновения для тех, кто любит готовить: от новичка до шефа сети ресторанов.";

const features = [
	"Кулинарная платформа с аутентичными и авторскими рецептами блюд со всего мира от ведущих шефов. Мы приглашаем к сотрудничеству шеф-поваров со всего мира с прозрачной монетизацией.",
	"Кулинарная онлайн-школа с последующим трудоустройством в Украине и за рубежом.",
	"Коллекция лайфхаков.",
	"Навигатор: где купить нужные продукты или кухонное оборудование.",
	"Маркетплейс, где повар может продать свои услуги, а поставщик — товар.",
	"Профессиональные рекомендации по открытию ресторана, кафе и других заведений.",
	"Технологические карты для шеф-поваров на все блюда.",
	"Место, где собираются те, кто бесконечно влюблён и верит в таинство, происходящее на кухне, — вне зависимости от её размеров.",
];
---
<BaseLayout title="О проекте" description={description} breadcrumbs={[{ label: "О проекте" }]}>
	<PageHero slot="hero" eyebrow="О проекте" description={description}>
		Академия <span class="page-hero__accent">Гурмэ</span>
	</PageHero>

	<section class="about-intro section-item">
		<div class="about-intro__text">
			<h2 class="about-intro__title">Добро пожаловать в академию Гурмэ!</h2>
			<p>
				Еда — источник наслаждения, возведённый в ранг искусства, которое удовлетворяет все пять чувств
				одновременно. Мы восхищаемся хорошими блюдами, наслаждаемся ими и вкладываем в их приготовление всю душу —
				неважно, готовим мы дома для себя и любимых людей или для тысячи гостей, будучи шефом сети ресторанов.
			</p>
			<p>
				Получать наслаждение никак не связано с размером кошелька: есть невероятное количество рецептов, которые
				удовлетворят самый изысканный вкус при мизерной стоимости ингредиентов.
			</p>
		</div>
		<ul class="about-stats">
			{stats.map((stat) => (
				<li class="about-stats__item">
					<strong class="about-stats__value">{stat.value.toLocaleString("ru-RU")}</strong>
					<span class="about-stats__label">{stat.label}</span>
				</li>
			))}
		</ul>
	</section>

	<section class="about-mission section-item">
		<h2 class="about-mission__title">Чем является академия Гурмэ?</h2>
		<p class="about-mission__text">
			Само название точно описывает, кем мы хотим быть для вас: платформой обучения и вдохновения, вне зависимости
			от вашего статуса на момент нашего знакомства. Ведь постоянное обучение нужно и новичку, и профессионалу.
		</p>
		<blockquote class="about-mission__quote">
			Рецепты, написанные, созданные и проверенные поварами для поваров.
		</blockquote>
		<p class="about-mission__text">
			Основной акцент — на поиске аутентичных рецептов с учётом их территориальности и ингредиентов, которые
			максимально гармонично создают то или иное блюдо.
		</p>
	</section>

	<Section>
		<Fragment slot="title">
			Академия Гурмэ — <span class="section-title__accent">это</span>
		</Fragment>
		<ol class="about-features">
			{features.map((text, i) => (
				<li class="about-features__item">
					<span class="about-features__number">{String(i + 1).padStart(2, "0")}</span>
					<p class="about-features__text">{text}</p>
				</li>
			))}
		</ol>
	</Section>

	<section class="about-goal section-item">
		<div class="about-goal__card">
			<p class="about-goal__eyebrow">Наша цель</p>
			<p class="about-goal__text">
				Быть интеллектуальной платформой №1, которая заботится о вас и рекомендует блюда по вашим личным
				предпочтениям — с учётом аллергий и индивидуальных рекомендаций для каждого подписчика. Чтобы еда, которую
				вы готовите, всегда была в радость и, как говорится, на здоровье, а не во вред.
			</p>
			<a class="btn btn--primary" href="/categories">Смотреть рецепты</a>
		</div>
	</section>

	<SubscribeSection />
</BaseLayout>

<style lang="less">
.about-intro {
	display: grid;
	gap: 40px;
	padding-top: 25px;
	@media @tablet {
		grid-template-columns: 3fr 2fr;
		align-items: center;
	}
	&__text {
		display: grid;
		gap: 16px;
		color: var(--color-grey-dark);
		line-height: 1.6;
	}
	&__title {
		font-weight: 800;
		font-size: 28px;
		line-height: 1.2;
		color: var(--color-black);
	}
}

.about-stats {
	display: grid;
	gap: 14px;
	&__item {
		display: flex;
		align-items: baseline;
		gap: 14px;
		padding: 22px 28px;
		background: var(--color-light-grey);
		border-radius: var(--border-radius-25);
	}
	&__value {
		font-weight: 900;
		font-size: 44px;
		line-height: 1;
		color: var(--color-red);
	}
	&__label {
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: .5px;
		font-size: 13px;
	}
}

.about-mission {
	max-width: 820px;
	margin-inline: auto;
	text-align: center;
	&__title {
		margin-bottom: 20px;
		font-weight: 800;
		font-size: 28px;
		line-height: 1.2;
	}
	&__text {
		color: var(--color-grey-dark);
		line-height: 1.6;
	}
	&__quote {
		margin: 32px 0;
		padding: 0 20px;
		font-style: italic;
		font-weight: 800;
		font-size: 24px;
		line-height: 1.3;
		color: var(--color-red);
		&::before,
		&::after {
			content: "«";
		}
		&::after {
			content: "»";
		}
	}
}

.about-features {
	display: grid;
	gap: 20px;
	@media @tablet {
		grid-template-columns: repeat(2, 1fr);
	}
	@media (min-width: 1100px) {
		grid-template-columns: repeat(4, 1fr);
	}
	&__item {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 26px 24px;
		background: var(--color-white);
		border-radius: var(--border-radius-25);
		box-shadow: 0 4px 15px var(--color-black-10);
		transition: transform .25s var(--ease), box-shadow .25s var(--ease);
		&:hover {
			transform: translateY(-6px);
			box-shadow: 0 20px 36px var(--color-black-10);
		}
	}
	&__number {
		font-weight: 900;
		font-size: 32px;
		line-height: 1;
		color: var(--color-red);
	}
	&__text {
		font-size: 15px;
		line-height: 1.5;
		color: var(--color-grey-dark);
	}
}

.about-goal {
	&__card {
		display: grid;
		justify-items: start;
		gap: 18px;
		padding: 40px;
		background: var(--color-black);
		border-radius: var(--border-radius-25);
		color: var(--color-white);
		@media (max-width: 860px) {
			padding: 28px 22px;
		}
	}
	&__eyebrow {
		font-style: italic;
		font-weight: 700;
		color: var(--color-red);
		text-transform: uppercase;
		letter-spacing: .5px;
	}
	&__text {
		max-width: 820px;
		font-size: 20px;
		line-height: 1.5;
	}
}
</style>
