---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/layout/PageHero.astro";
import CardGrid from "../../components/ui/CardGrid.astro";
import type { News } from "../../types/news";
import { plural } from "../../utils/plural";

const API_URL = import.meta.env.API_URL ?? "http://localhost:8000/api";
const { data: news }: { data: News[] } = await fetch(`${API_URL}/news?limit=50`).then((r) => r.json());

const formatDate = (date: string) => new Date(date).toLocaleDateString("ru-RU", { day: "numeric", month: "long", year: "numeric" });
// Same placeholder as the news block on the home page, for posts without a cover.
const placeholder = "https://foodies.academy/wp-content/uploads/2025/11/mat-300x300.jpeg";
const description = `${news.length} ${plural(news.length, ["статья", "статьи", "статей"])} о еде, продуктах и кулинарных трендах.`;
---
<BaseLayout title="Новости" description={description} breadcrumbs={[{ label: "Новости" }]}>
	<PageHero slot="hero" eyebrow="Журнал" description={description}>
		<span class="page-hero__accent">Новости</span>
	</PageHero>

	<section class="news-list section-item">
		<CardGrid minCardWidth={280}>
			{news.map((item) => (
				<a href={`/news/${item.slug}`} class="news-card">
					<div class="news-card__img" style={`background-image: url('${item.image || placeholder}')`}></div>
					<div class="news-card__body">
						<span class="news-card__meta">{[item.category, formatDate(item.date)].filter(Boolean).join(" · ")}</span>
						<h2 class="news-card__title">{item.title}</h2>
						<p class="news-card__excerpt">{item.excerpt}</p>
					</div>
				</a>
			))}
		</CardGrid>
	</section>
</BaseLayout>

<style lang="less">
.news-list {
	padding-top: 25px;
}

.news-card {
	display: flex;
	flex-direction: column;
	background: var(--color-white-10);
	box-shadow: 0 4px 15px var(--color-black-10);
	border-radius: var(--border-radius-25);
	overflow: hidden;
	transition: transform .25s var(--ease), box-shadow .25s var(--ease);
	&:hover {
		transform: translateY(-6px);
		box-shadow: 0 20px 36px var(--color-black-10);
	}
	&__img {
		aspect-ratio: 3/2;
		background-size: cover;
		background-position: center;
	}
	&__body {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 20px;
	}
	&__meta {
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: .5px;
		color: var(--color-red);
	}
	&__title {
		font-weight: 700;
		font-size: 18px;
		line-height: 1.3;
	}
	&__excerpt {
		font-size: 14px;
		line-height: 1.5;
		color: var(--color-grey-dark);
	}
}
</style>
