---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Breadcrumbs from "../components/layout/Breadcrumbs.astro";
import BackToTop from "../components/layout/BackToTop.astro";
import Toast from "../components/ui/Toast.astro";
import type { Breadcrumb } from "../types/breadcrumb";
import type { Seo } from "../types/seo";
import { jsonLd } from "../utils/jsonLd";
import "../styles/global.less";

interface Props {
	// Page name, shown before the site name in the browser tab.
	title?: string;
	// Search-result snippet for the page; the site-wide one if omitted.
	description?: string;
	// Trail shown under the header, after "Главная". Omit on the home page.
	breadcrumbs?: Breadcrumb[];
	// Pages search engines shouldn't list (log-in, profile).
	noindex?: boolean;
	// Yoast SEO fields of the WordPress object behind the page; they win over title/description.
	seo?: Seo | null;
	// Picture for social networks when Yoast has none (a recipe's photo, a video's thumbnail).
	image?: string;
	// og:type when Yoast has none: "article" for recipes and news, "website" otherwise.
	type?: string;
}

const {
	title,
	description = "Foodies Academy — рецепты с пошаговыми фото и видео: основные блюда, супы, салаты, десерты и выпечка.",
	breadcrumbs,
	noindex = false,
	seo,
	image,
	type = "website",
} = Astro.props;

const SITE_NAME = "Foodies.academy";
// `site` from astro.config; unset when a component is rendered on its own (tests).
const site = Astro.site ?? new URL("https://foodies.academy");
// Yoast titles already end with the site name.
const fullTitle = seo?.title ?? (title ? `${title} — ${SITE_NAME}` : SITE_NAME);
const metaDescription = seo?.description ?? description;
// This page's address on the site, without ?query; Yoast's canonical points at WordPress.
// The build sees the file (recipe/x.html), the page is served at /recipe/x.
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/");
const canonical = new URL(path, site).href;
const robots = [noindex || seo?.index === false ? "noindex" : "index", noindex || seo?.follow === false ? "nofollow" : "follow"];
const ogImage = seo?.og.image ?? (image ? { url: new URL(image, site).href, width: null, height: null, type: null } : null);
const ogTitle = seo?.og.title ?? fullTitle;
const ogDescription = seo?.og.description ?? metaDescription;

// The breadcrumb trail for Google: "Главная" first, the current page (no href) last.
const breadcrumbSchema = breadcrumbs?.length
	? jsonLd({
			"@type": "BreadcrumbList",
			itemListElement: [{ label: "Главная", href: "/" }, ...breadcrumbs].map((crumb, i) => ({
				"@type": "ListItem",
				position: i + 1,
				name: crumb.label,
				item: new URL(crumb.href ?? path, site).href,
			})),
		})
	: null;
---

<html lang="ru">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg">
		<link rel="icon" href="/favicon.ico" sizes="32x32">
		<!-- Favicons -->
		<link rel="apple-touch-icon" sizes="57x57" href="/apple-icon-57x57.png">
		<link rel="apple-touch-icon" sizes="60x60" href="/apple-icon-60x60.png">
		<link rel="apple-touch-icon" sizes="72x72" href="/apple-icon-72x72.png">
		<link rel="apple-touch-icon" sizes="76x76" href="/apple-icon-76x76.png">
		<link rel="apple-touch-icon" sizes="114x114" href="/apple-icon-114x114.png">
		<link rel="apple-touch-icon" sizes="120x120" href="/apple-icon-120x120.png">
		<link rel="apple-touch-icon" sizes="144x144" href="/apple-icon-144x144.png">
		<link rel="apple-touch-icon" sizes="152x152" href="/apple-icon-152x152.png">
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-icon-180x180.png">
		<link rel="icon" type="image/png" sizes="192x192"  href="/android-icon-192x192.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="manifest" href="/manifest.json">
		<meta name="msapplication-TileColor" content="#ffffff">
		<meta name="msapplication-TileImage" content="/ms-icon-144x144.png">
		<meta name="theme-color" content="#ffffff">
		{/* Every page uses the upright font; fetch it before the CSS asks for it. */}
		<link rel="preload" href="/fonts/Montserrat-Variable.woff2" as="font" type="font/woff2" crossorigin>
		<title>{fullTitle}</title>
		<meta name="description" content={metaDescription}>
		<meta name="robots" content={`${robots.join(", ")}${robots[0] === "index" ? ", max-snippet:-1, max-image-preview:large, max-video-preview:-1" : ""}`}>
		<link rel="canonical" href={canonical}>

		{/* Open Graph and Twitter: Yoast's fields, or the page's own title, description and picture. */}
		<meta property="og:locale" content="ru_RU">
		<meta property="og:type" content={seo?.og.type ?? type}>
		<meta property="og:title" content={ogTitle}>
		<meta property="og:description" content={ogDescription}>
		<meta property="og:url" content={canonical}>
		<meta property="og:site_name" content={seo?.og.siteName ?? SITE_NAME}>
		{ogImage && <meta property="og:image" content={ogImage.url}>}
		{ogImage?.width && <meta property="og:image:width" content={String(ogImage.width)}>}
		{ogImage?.height && <meta property="og:image:height" content={String(ogImage.height)}>}
		{ogImage?.type && <meta property="og:image:type" content={ogImage.type}>}
		{seo?.og.publishedTime && <meta property="article:published_time" content={seo.og.publishedTime}>}
		{seo?.og.modifiedTime && <meta property="article:modified_time" content={seo.og.modifiedTime}>}
		<meta name="twitter:card" content={seo?.twitter.card ?? "summary_large_image"}>
		<meta name="twitter:title" content={seo?.twitter.title ?? ogTitle}>
		<meta name="twitter:description" content={seo?.twitter.description ?? ogDescription}>
		{(seo?.twitter.image ?? ogImage?.url) && <meta name="twitter:image" content={seo?.twitter.image ?? ogImage?.url}>}
		<link rel="sitemap" href="/sitemap.xml">
		{breadcrumbSchema && <script type="application/ld+json" is:inline set:html={breadcrumbSchema} />}
	</head>
	<body>
		<Header />
		{breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
		{/* Full-width intro between the breadcrumbs and the page content (e.g. PageHero). */}
		<slot name="hero" />
		<main class="container"><slot /></main>
		<Footer />
		<BackToTop />
		<Toast />
	</body>
</html>
