---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Breadcrumbs from "../components/layout/Breadcrumbs.astro";
import type { Breadcrumb } from "../types/breadcrumb";
import "../styles/global.less";

interface Props {
	// Page name, shown before the site name in the browser tab.
	title?: string;
	// Search-result snippet for the page; the site-wide one if omitted.
	description?: string;
	// Trail shown under the header, after "Главная". Omit on the home page.
	breadcrumbs?: Breadcrumb[];
}

const {
	title,
	description = "Foodies Academy — рецепты с пошаговыми фото и видео: основные блюда, супы, салаты, десерты и выпечка.",
	breadcrumbs,
} = Astro.props;
---

<html lang="ru">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{title ? `${title} — Foodies.academy` : "Foodies.academy"}</title>
		<meta name="description" content={description}>
	</head>
	<body>
		<Header />
		{breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
		{/* Full-width intro between the breadcrumbs and the page content (e.g. PageHero). */}
		<slot name="hero" />
		<main class="container"><slot /></main>
		<Footer />
	</body>
</html>

<script>
	// Header shadow once the page is scrolled; "back to top" button further down.
	const header = document.querySelector<HTMLElement>(".header");
	const backToTop = document.querySelector<HTMLButtonElement>(".back-to-top");

	const onScroll = () => {
		header?.classList.toggle("is-scrolled", window.scrollY > 8);
		backToTop?.classList.toggle("is-visible", window.scrollY > 600);
	};
	window.addEventListener("scroll", onScroll, { passive: true });
	onScroll();

	backToTop?.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
</script>
