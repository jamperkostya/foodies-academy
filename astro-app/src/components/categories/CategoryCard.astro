---
import type { Category } from "../../types/category";

interface Props {
	category: Category;
}

const { category } = Astro.props;

const recipeWord = {
	one: "рецепт",
	few: "рецепта",
	many: "рецептов",
	other: "рецепта",
}[new Intl.PluralRules("ru-RU").select(category.recipesCount)];
---
<a href={`/category/${category.slug}`} class="category-card" data-groups={JSON.stringify(category.groups)}>
	<div class="category-card__img" style={`background-image:url('${category.image}')`}></div>
	<div class="category-card__label">
		<strong class="category-card__title">{category.title}</strong>
		<small class="category-card__count">{category.recipesCount} {recipeWord}</small>
	</div>
</a>
<style lang="less">
.category-card {
	position: relative;
	border-radius: var(--border-radius-25);
	overflow: hidden;
	aspect-ratio: 3/5;
	min-height: 325px;
	color: var(--color-white);
	cursor: pointer;
	transition: transform .25s var(--ease), box-shadow .25s var(--ease);
	display: flex;
	justify-content: center;
	align-items: center;
	&::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(180deg, rgba(0,0,0,0) 45%, rgba(0,0,0,.78) 100%);
		transition: background .25s;
	}
	&:hover {
		transform: translateY(-6px);
		box-shadow: 0 5px 5px rgba(29,27,32,.18);
		.category-card__img {
			transform: scale(1.1);
		}
		&::after {
			background: linear-gradient(180deg, rgba(0,0,0,.05) 30%, rgba(0,0,0,.85) 100%);
		}
	}
}

.category-card__img {
	position: absolute;
	inset: 0;
	z-index: 0;
	background-size: cover;
	background-position: center;
	transition: transform .5s var(--ease);
}

.category-card__label {
	position: relative;
	z-index: 2;
	text-align: center;
}

.category-card__title {
	display: block;
	font-weight: 700;
	font-size: 16px;
	line-height: 20px;
}

.category-card__count {
	display: block;
}
</style>
