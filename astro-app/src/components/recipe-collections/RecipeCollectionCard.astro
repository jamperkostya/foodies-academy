---
import Icon from "../ui/Icon.astro";
interface Props {
  recipeCollection: recipeCollection;
}

const { recipeCollection } = Astro.props;
---

<a href="#" class="collection-card flex">
	<div class="collection-card__img" style={`background-image: url('${recipeCollection.image}')`}></div>
		<span class="collection-card__arrow" aria-hidden="true">
			<Icon name="arrow-recipe" width={33} height={33} />
		</span>
	<div class="collection-card__label">{recipeCollection.title}</div>
</a>

<style lang="less">
.collection-card {
	color: var(--color-white);
	font-weight: 900;
	font-size: 20px;
	line-height: 24px;
	position: relative;
	border-radius: var(--border-radius-25);
	overflow: hidden;
	aspect-ratio: 4/3;
	transition: transform .25s var(--ease), box-shadow .25s var(--ease);
	padding: 20px 30px;
	align-items: flex-end;
	.collection-card__img {
		position: absolute;
		inset: 0;
		z-index: 0;
		background-size: cover;
		background-position: center;
		transition: transform .5s var(--ease);
	}
	.collection-card__arrow {
		position: absolute;
		top: 12px;
		right: 12px;
		width: 30px;
		height: 30px;
		z-index: 3;
		transition: background .2s, color .2s, transform .2s var(--ease);
	}
	.collection-card__label {
		position: relative;
		z-index: 2;
	}
	&::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,.7) 100%);
	}
	&:hover {
		box-shadow: 0 20px 34px rgba(29,27,32,.18);
		transform: translateY(-6px);
		.collection-card__img {
			transform: scale(1.08);
		}
		.collection-card__arrow {
			transform: rotate(45deg);
		}
	}
	&:active {
		transform: translateY(-2px) scale(.98);
	}
}
</style>