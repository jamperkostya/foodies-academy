---
// A news card for grids: cover, rubric and date, title, excerpt.
import type { News } from "../../types/news";

interface Props {
	news: News;
	// Section the card links into: news or the blog.
	base?: "/news" | "/blog";
}

const { news, base = "/news" } = Astro.props;

const date = new Date(news.date).toLocaleDateString("ru-RU", { day: "numeric", month: "long", year: "numeric" });
// Same placeholder as the news block on the home page, for posts without a cover.
const image = news.image || "https://foodies.academy/wp-content/uploads/2025/11/mat-300x300.jpeg";
---
<a href={`${base}/${news.slug}`} class="news-card">
	<div class="news-card__img" style={`background-image: url('${image}')`}></div>
	<div class="news-card__body">
		<span class="news-card__meta">{[news.category, date].filter(Boolean).join(" · ")}</span>
		<h2 class="news-card__title">{news.title}</h2>
		<p class="news-card__excerpt">{news.excerpt}</p>
	</div>
</a>

<style lang="less">
.news-card {
	display: flex;
	flex-direction: column;
	background: var(--color-white-10);
	box-shadow: 0 4px 15px var(--color-black-10);
	border-radius: var(--border-radius-25);
	overflow: hidden;
	transition: transform .25s var(--ease), box-shadow .25s var(--ease);
	&:hover {
		transform: translateY(-6px);
		box-shadow: 0 20px 36px var(--color-black-10);
	}
	&__img {
		aspect-ratio: 3/2;
		background-size: cover;
		background-position: center;
	}
	&__body {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 20px;
	}
	&__meta {
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: .5px;
		color: var(--color-red);
	}
	&__title {
		font-weight: 700;
		font-size: 18px;
		line-height: 1.3;
	}
	&__excerpt {
		font-size: 14px;
		line-height: 1.5;
		color: var(--color-grey-dark);
	}
}
</style>
