---
import Icon from "../ui/Icon.astro";
import HeroStats from "./VideoStats.astro";
import Stars from "../ui/Stars.astro";

interface Props {
	href: string;
	size: "tall" | "half";
	image: string;
	title: string;
	views: number;
	likes: number;
	comments: number;
	rating: number;
	videoId?: string;
	// Filter groups this card matches, when its carousel has filters.
	groups?: string[];
}

const { href, size, image, title, views, likes, comments, rating, videoId, groups } = Astro.props;
---

<a href={href} class={`hero-card hero-card--${size}`} data-groups={groups && JSON.stringify(groups)}>
	<div class="hero-card__img" style={`background-image:url('${image}')`}></div>
	{videoId ? (
		<div class="hero-card__top flex flex-between">
			<button class="hero-card__play-badge" id={videoId}><Icon name="youtube-play" width={42} height={29} /></button>
			<HeroStats views={views} likes={likes} comments={comments} rating={rating} />
		</div>
	) : (
		<HeroStats views={views} likes={likes} comments={comments} rating={rating} />
	)}
	<div class="hero-card__title">{title}</div>
</a>

<style lang="less">
	@import "./HeroCard.less";
</style>
