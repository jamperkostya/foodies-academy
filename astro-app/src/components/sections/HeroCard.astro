---
import Icon from "../ui/Icon.astro";
import VideoStats from "./VideoStats.astro";
import Stars from "../ui/Stars.astro";

interface Props {
	href: string;
	size: "tall" | "half";
	image: string;
	title: string;
	views?: number;
	likes?: number;
	comments?: number;
	rating: number;
	videoId?: string;
	// Filter groups this card matches, when its carousel has filters.
	groups?: string[];
}

const { href, size, image, title, views, likes, comments, rating, videoId, groups } = Astro.props;
---

<a href={href} class={`video-card video-card--${size}`} data-groups={groups && JSON.stringify(groups)}>
	<div class="video-card__img" style={`background-image:url('${image}')`}></div>
	<div class="video-card__top flex flex-between">
		{videoId ? <button class="video-card__play-badge" id={videoId}><Icon name="youtube-play" width={42} height={29} /></button> : null}
		<VideoStats views={views} likes={likes} comments={comments} rating={rating} />
	</div>
	<div class="video-card__title">{title}</div>
</a>

<style lang="less">
	@import "./VideoCard.less";
</style>
