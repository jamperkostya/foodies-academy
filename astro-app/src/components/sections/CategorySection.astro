---
import Section from "../layout/Section.astro";
import Carousel from "../ui/Carousel.astro";
import CategoryCard from "../categories/CategoryCard.astro";
import type { Category } from "../../types/category";

interface Props {
	categories: Category[];
	// "Смотреть все" link, next to the section title.
	href?: string;
}

const { categories, href } = Astro.props;
---
<Section href={href}>
	<slot name="title" slot="title" />
	<Carousel variant="categories">
		{categories.map((category) => (
			<CategoryCard class="carousel__item" category={category} />
		))}
	</Carousel>
</Section>
