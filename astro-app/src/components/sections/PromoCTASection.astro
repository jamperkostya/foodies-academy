<style lang="less">
.promo {
	border-radius: var(--border-radius-25);
	overflow: hidden;
	padding: 13px 13px 13px 40px;
	display: grid;
	grid-template-columns: 1fr 1fr;
	align-items: stretch;
	gap: 7px;
	.promo-text {
		gap: 30px;
		align-content: center;
		.promo-text__title {
			margin: 0;
		}
		.promo-text__descriptions {
			font-weight: 400;
			font-size: 16px;
			line-height: 150%;
		}
	}
	&:hover {
		.promo__img {
			transform: scale(1.05);
		}
	}
	.promo-media {
		position: relative;
		min-height: 400px;
		overflow: hidden;
		border-radius: 20px;
		.promo__img {
			position: absolute;
			inset: 0;
			background-size: cover;
			background-position: center;
			transition: transform .6s var(--ease);
		}
	}
}
.promo-cta {
	gap: 42px;
	padding: 0;
	.promo-text {
		order: 2;
	}
	.promo-media {
		order: 1;
	}
	.btn {
		width: fit-content;
	}
}
</style>