<section class="section--item">
	<div class="promo promo-cta">
		<div class="promo-text grid">
			<h3 class="promo-text__title section--title"><span>Ingredient</span> Guide</h3>
			<h3 class="promo-text__title section--title">Get Started. 10 Ingredients. Hundreds of Recipes</h3>
			<div class="promo-text__descriptions">
				<p>
					Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
				</p>
			</div>
			<a href="promo" class="btn">Browse Guide</a>
		</div>
		<div class="promo-media">
			<div class="promo__img" style="background-image:url('https://foodies.academy/wp-content/uploads/2025/11/1615444442-5347-300x300.jpg')"></div>
