---
// Home page block from a WordPress page (title, excerpt, featured image) with a button to the page.
import type { SitePage } from "../../types/page";

interface Props {
	page: SitePage;
	buttonLabel?: string;
}

const { page, buttonLabel = "Browse Guide" } = Astro.props;
// Until a featured image is set in WordPress.
const image = page.image || "https://foodies.academy/wp-content/uploads/2025/11/1615444442-5347-300x300.jpg";
---

<section class="section-item">
	<div class="promo promo--cta">
		<div class="promo__text grid gap-30">
			<h3 class="promo__text-title section-title">{page.title}</h3>
			{page.excerpt && (
				<div class="promo__descriptions">
					<p class="promo__desc">{page.excerpt}</p>
				</div>
			)}
			<a href={`/${page.slug}`} class="btn btn--primary">{buttonLabel}</a>
		</div>
		<div class="promo__media">
			<div class="promo__img" style={`background-image:url('${image}')`}></div>
		</div>
	</div>
</section>

<style lang="less">
@import "./Promo.less";
.promo--cta {
	gap: 42px;
	padding: 0;
	@media (max-width: 860px) {
		gap: 20px;
	}
	.promo__text {
		order: 2;
	}
	.promo__media {
		order: 1;
	}
}
</style>
