---
import Icon from "../ui/Icon.astro";
import VideoCard from "../videos/VideoCard.astro";
import { heroCards } from "../../data/heroCards";
import type { HeroCard } from "../../types/heroCard";

// Adjacent "half" cards render stacked inside one column; this grouping is
// derived from each card's own `size`, not authored separately in the data.
type RenderGroup = { kind: "tall"; card: HeroCard } | { kind: "stack"; cards: HeroCard[] };

function groupHeroCards(cards: HeroCard[]): RenderGroup[] {
	const groups: RenderGroup[] = [];
	for (const card of cards) {
		if (card.size === "tall") {
			groups.push({ kind: "tall", card });
			continue;
		}
		const last = groups[groups.length - 1];
		if (last?.kind === "stack") {
			last.cards.push(card);
		} else {
			groups.push({ kind: "stack", cards: [card] });
		}
	}
	return groups;
}

const heroGroups = groupHeroCards(heroCards);
---

<section class="hero section-item">
	<div class="carousel carousel--hero">
		<div class="carousel__track">
			{heroGroups.map((group) =>
				group.kind === "tall" ? (
					<VideoCard {...group.card} />
				) : (
					<div class="hero__stack">
						{group.cards.map((card) => (
							<VideoCard {...card} />
						))}
					</div>
				)
			)}
		</div>
		<button type="button" class="carousel__arrow carousel__arrow--prev" aria-label="Назад">
			<Icon name="arrow-slider" width={12} height={10} />
		</button>
		<button type="button" class="carousel__arrow carousel__arrow--next" aria-label="Вперёд">
			<Icon name="arrow-slider" width={12} height={10} />
		</button>
	</div>
	<div class="carousel__dots"></div>
</section>

<style lang="less">
	@import "./Hero.less";
</style>

<script>
	import { initDragCarousel } from "../../scripts/dragCarousel";

	const heroCarouselEl = document.querySelector<HTMLElement>(".carousel--hero");
	if (heroCarouselEl) initDragCarousel(heroCarouselEl);
</script>
