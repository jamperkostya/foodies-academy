// Adjacent "half" cards render stacked inside one column; this grouping is
// derived from each card's own `size`, not authored separately in the data.
type RenderGroup = { kind: "tall"; card: HeroCardData } | { kind: "stack"; cards: HeroCardData[] };

function groupHeroCards(cards: HeroCardData[]): RenderGroup[] {
	const groups: RenderGroup[] = [];
	for (const card of cards) {
		if (card.size === "tall") {
			groups.push({ kind: "tall", card });
			continue;
		}
		const last = groups[groups.length - 1];
		if (last?.kind === "stack") {
			last.cards.push(card);
		} else {
			groups.push({ kind: "stack", cards: [card] });
		}
	}
	return groups;
}

const heroGroups = groupHeroCards(heroCards);
---

<section class="hero section-item">
	<div class="carousel carousel--hero">
		<div class="carousel__track" id="heroGrid">
			{heroGroups.map((group) =>
				group.kind === "tall" ? (
					<HeroCard {...group.card} />
				) : (
					<div class="hero__stack">
						{group.cards.map((card) => (
							<HeroCard {...card} />
						))}
					</div>
				)
			)}
		</div>
		<button class="carousel__arrow carousel__arrow--prev" aria-label="Назад">
			<Icon name="arrow-slider" width={12} height={10} />
		</button>
		<button class="carousel__arrow carousel__arrow--next" aria-label="Вперёд">
			<Icon name="arrow-slider" width={12} height={10} />
		</button>
	</div>
	<div class="carousel__dots" id="heroDots"></div>
</section>

<style lang="less">
	@import "./Hero.less";
</style>

<script>
	import { initDragCarousel } from "../../scripts/dragCarousel";

	const heroCarouselEl = document.querySelector<HTMLElement>(".carousel--hero");
	if (heroCarouselEl) initDragCarousel(heroCarouselEl);
</script>
