<style lang="less">
.seo-text {
	max-width: 80%;
	margin: auto;
	.section-title {
		margin: 0;
	}
	.btn {
		display: block;
		margin: auto;
		margin-top: 40px;
	}
}
</style>
<script>
// ---------------------------------------------------------------------------
// SEO-text block show more / show less
// ---------------------------------------------------------------------------
document.querySelectorAll('.clamped-text__toggle').forEach((toggle) => {
  toggle.addEventListener('click', () => {
    const clampedBlock = toggle.parentElement?.querySelector('.clamped-text');
    if (!clampedBlock) return;
    const expanded = clampedBlock.classList.toggle('is-clamped') === false;
    toggle.textContent = expanded ? 'Свернуть' : 'Показать больше';
  });
});
</script>