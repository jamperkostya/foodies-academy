		<button type="button" class="seo-text__toggle btn btn--secondary" aria-expanded="false">Показать больше</button>
	</div>
</section>

<style lang="less">
.seo-text {
	max-width: 80%;
	margin: auto;
}

.seo-text__title {
	margin: 0;
}

.seo-text__toggle {
	display: block;
	margin: 40px auto 0;
}
</style>

<script>
	// Show more / show less: toggles the 3-line clamp on the text.
	document.querySelectorAll<HTMLElement>(".seo-text").forEach((block) => {
		const body = block.querySelector(".seo-text__body");
		const toggle = block.querySelector(".seo-text__toggle");
		if (!body || !toggle) return;

		toggle.addEventListener("click", () => {
			const expanded = !body.classList.toggle("is-clamped");
			toggle.textContent = expanded ? "Свернуть" : "Показать больше";
			toggle.setAttribute("aria-expanded", String(expanded));
		});
	});
</script>
