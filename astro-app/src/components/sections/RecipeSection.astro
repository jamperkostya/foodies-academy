---
import RecipeGrid from '../recipes/RecipeGrid.astro';
import type { Recipe } from '../../types/recipe';

interface Props {
	recipes: Recipe[];
	href?: string;
	trackId?: string;
}
const { recipes, href, trackId } = Astro.props;
---

<section class="section--item section--cream">
	<div class="section-head">
		<h2 class="section--title"><slot name="title" /></h2>
	</div>

	<RecipeGrid recipes={recipes} trackId={trackId} />
</section>

<style lang="less">
	.section-head__all {
		flex: 0 0 auto;
		font-weight: 600;
		font-size: 14px;
		color: var(--color-red);
		white-space: nowrap;
		transition: opacity .15s;
		&:hover {
			opacity: .7;
		}
	}
</style>