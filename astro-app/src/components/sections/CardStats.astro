---
import Icon from "../ui/Icon.astro";
import Stars from "../ui/Stars.astro";

interface Props {
	views: number;
	likes: number;
	comments: number;
	time: number;
}

const { views, likes, comments, time } = Astro.props;
---
<div class="recipe-card__stats flex">
	<span class="recipe-card__stat flex gap-3"><Icon name="comment" width={16} height={16} />{comments}</span>
	<span class="recipe-card__stat flex gap-3"><Icon name="like" width={16} height={16} />{likes}</span>
	<span class="recipe-card__stat flex gap-3"><Icon name="views" width={16} height={16} />{views}</span>
	<span class="recipe-card__stat recipe-card__stat--time flex gap-3"><Icon name="clock" width={16} height={16} />{time}</span>
</div>

<style lang="less">
.recipe-card__stats {
	border-top: var(--border-width) solid var(--color-black-20);
	padding-top: 13px;
	font-weight: 300;
	font-size: 14px;
	line-height: 17px;
	color: var(--color-grey);
	justify-content: space-between;
	gap: 15px;
	.recipe-card__stat--time {
		&::before {
			content: '';
			border-left: var(--border-width) solid var(--color-grey);
			margin-right: 15px;
		}
	}
}
</style>