---
import Section from "../layout/Section.astro";
import Carousel from "../ui/Carousel.astro";
import VideoCard from "../videos/VideoCard.astro";
import type { Video } from "../../types/video";

interface Props {
	videos: Video[];
	// "Смотреть все" link, shown at the end of the filters row.
	href?: string;
}

const { videos, href } = Astro.props;
---
<Section href={href}>
	<slot name="title" slot="title" />
	<Carousel variant="videos">
		{videos.map((video) => (
			<VideoCard
				class="carousel__item"
				href={`/video/${video.slug}`}
				size="compact"
				image={video.image}
				title={video.title}
				views={video.views}
				likes={video.likes}
				comments={video.comments}
				rating={video.rating}
				videoId={video.youtubeId}
			/>
		))}
	</Carousel>
</Section>
