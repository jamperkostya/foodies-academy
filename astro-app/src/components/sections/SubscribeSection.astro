---
---
<section class="section-item">
	<div class="subscribe flex gap-40">
		<img class="subscribe__img" src="/images/subscribe.jpg" alt="Кулинарная книга Foodies" width="625" height="327" loading="lazy">

		<form method="post" action="#" class="subscribe__form flex gap-15">
			<h2 class="subscribe__title">Подпишись и получи книгу рецептов бесплатно!</h2>

			<input class="subscribe__input" type="text" name="name" placeholder="Имя" aria-label="Имя" autocomplete="given-name" required>

			<input class="subscribe__input" type="email" name="email" placeholder="E-mail" aria-label="E-mail" autocomplete="email" required>

			<button type="submit" class="subscribe__btn btn btn--primary">Подписаться</button>
		</form>
	</div>
</section>

<style lang="less">
.subscribe {
	align-items: center;
	padding: 25px;
	background: var(--color-white);
	border: var(--border-width) solid var(--color-black-50);
	border-radius: var(--border-radius-25);
	@media (max-width: 860px) {
		flex-direction: column;
	}
	// Image takes 2/3 of the row, the form the remaining 1/3.
	&__img {
		flex: 2 1 0;
		min-width: 0;
		max-width: 100%;
		height: auto;
		@media (max-width: 860px) {
			flex: none;
		}
	}
	&__form {
		flex: 1 1 0;
		flex-direction: column;
		@media (max-width: 860px) {
			align-self: stretch;
		}
	}
}

.subscribe__title {
	font-weight: 700;
	font-size: 16px;
	line-height: 29px;
	text-transform: uppercase;
}

.subscribe__input {
	width: 100%;
	padding: 16px 25px;
	border: var(--border-width) solid var(--color-border-search-form);
	border-radius: var(--border-radius-1000);
	background: var(--color-white);
	font-size: 16px;
	line-height: 20px;
	outline: none;
	transition: border-color .15s;
	&:focus {
		border-color: var(--color-red);
	}
}

.subscribe__btn {
	width: 100%;
	text-transform: uppercase;
}
</style>
