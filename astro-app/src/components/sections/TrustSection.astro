---
import { shortCount as short } from "../../utils/shortCount";

// Totals from the WordPress database (GET /api/stats), rounded down for display.
const API_URL = import.meta.env.API_URL ?? "http://localhost:8000/api";
const totals: { recipes: number; ratings: number; views: number; comments: number } =
	(await fetch(`${API_URL}/stats`).then((r) => r.json())).data;

const stats = [
	{ ...short(totals.recipes), label: "рецептов" },
	{ ...short(totals.ratings), label: "оценок" },
	{ ...short(totals.views), label: "просмотров" },
	{ ...short(totals.comments), label: "комментариев" },
];
---

<section class="section-item">
	<div class="trust">
		<h3 class="trust__title section-title"><slot name="title" /></h3>
		<div class="trust__subtitle">Лучшая авторская кухня в Европе</div>

		<div class="trust__stats">
			{stats.map((stat) => (
				<div class="trust__stat" data-count={stat.count} data-decimals={stat.decimals} data-suffix={stat.suffix}>
					<strong class="trust__value">{stat.count.toLocaleString("ru-RU", { minimumFractionDigits: stat.decimals })}{stat.suffix}</strong>
					<span class="trust__label">{stat.label}</span>
				</div>
			))}
		</div>
	</div>
</section>

<style lang="less">
.trust {
	text-align: center;
	max-width: 80%;
	margin: auto;
}

.trust__title {
	margin-bottom: 20px;
}

.trust__subtitle {
	font-size: 16px;
	line-height: 20px;
	border-bottom: var(--border-width) solid var(--color-black);
	padding-bottom: 30px;
	text-transform: uppercase;
}

// One row of four on desktop, two by two on tablets, a column on phones.
.trust__stats {
	display: grid;
	grid-template-columns: repeat(4, minmax(0, 1fr));
	gap: 30px;
	margin: 40px 0 0;
	@media (max-width: 1199px) {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 40px;
	}
	@media (max-width: 640px) {
		grid-template-columns: 1fr;
	}
}

.trust__value {
	text-align: center;
	font-style: italic;
	font-weight: 600;
	// Scales with the window so "313 тыс.+" fits its column.
	font-size: clamp(40px, 3.4vw, 64px);
	line-height: 120%;
	color: var(--color-red);
	white-space: nowrap;
}

.trust__label {
	display: block;
	font-size: 16px;
	line-height: 150%;
	color: var(--color-black);
	text-transform: uppercase;
}
</style>

<script>
	// Count each stat up from 0 once it scrolls into view.
	const DURATION = 900;

	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				const stat = entry.target as HTMLElement;
				const value = stat.querySelector<HTMLElement>(".trust__value");
				const target = Number(stat.dataset.count);
				const suffix = stat.dataset.suffix ?? "";
				const decimals = Number(stat.dataset.decimals) || 0;
				observer.unobserve(stat);
				if (!value) return;

				const start = performance.now();
				const step = (now: number) => {
					const progress = Math.min(1, (now - start) / DURATION);
					const eased = 1 - Math.pow(1 - progress, 3);
					value.textContent = (target * eased).toLocaleString("ru-RU", { minimumFractionDigits: decimals, maximumFractionDigits: decimals }) + suffix;
					if (progress < 1) requestAnimationFrame(step);
				};
				requestAnimationFrame(step);
			});
		},
		{ threshold: 0.4 }
	);

	document.querySelectorAll<HTMLElement>(".trust__stat").forEach((stat) => observer.observe(stat));
</script>
