			transform: scale(1.05);
		}
	}
	.promo-media {
		position: relative;
		min-height: 400px;
		overflow: hidden;
		border-radius: 20px;
		.promo__img {
			position: absolute;
			inset: 0;
			background-size: cover;
			background-position: center;
			transition: transform .6s var(--ease);
		}
