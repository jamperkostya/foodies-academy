---
// Home page block from a WordPress page (title, excerpt, featured image); links to the page.
import type { SitePage } from "../../types/page";

interface Props {
	page: SitePage;
}

const { page } = Astro.props;
// Until a featured image is set in WordPress.
const image = page.image || "https://foodies.academy/wp-content/uploads/2025/11/1615444442-5347-300x300.jpg";
---

<section class="section-item">
	<a class="promo promo--link" href={`/${page.slug}`}>
		<div class="promo__text grid gap-20">
			<h3 class="promo__text-title section-title">{page.title}</h3>
			{page.excerpt && (
				<div class="promo__descriptions">
					<p class="promo__desc">{page.excerpt}</p>
				</div>
			)}
			<span class="promo__more">Подробнее →</span>
		</div>
		<div class="promo__media">
			<div class="promo__img" style={`background-image:url('${image}')`}></div>
		</div>
	</a>
</section>

<style lang="less">
@import "./Promo.less";
.promo {
	background: var(--color-gradient-violet);
	&--link {
		color: inherit;
		transition: transform .2s var(--ease);
		&:hover {
			transform: translateY(-3px);
		}
	}
	&__more {
		font-weight: 700;
		color: var(--color-red);
	}
	&__text {
		gap: 17px;
	}
}
</style>
