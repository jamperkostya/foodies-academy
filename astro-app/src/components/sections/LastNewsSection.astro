---
import Section from "../layout/Section.astro";
import type { News } from "../../types/news";

interface Props {
	// The first item is featured on the right, the next six are listed on the left.
	news: News[];
}

const { news } = Astro.props;
const [featured, ...restNews] = news;
const listNews = restNews.slice(0, 6);

// No news item has an image yet (see src/data/news.ts).
const featuredImage = featured?.image ?? "https://foodies.academy/wp-content/uploads/2025/11/mat-300x300.jpeg";
---

<Section>
	<slot name="title" slot="title" />
	<div class="news">
		<div class="news__list">
			{listNews.map((item) => (
				<a href={`/news/${item.slug}`} class="news__item">
					<div class="news__content">
						<div class="news__tags">
							<span class="news__category">{item.category}</span>
							{item.tags.map((tag) => <span class="news__tag">{tag}</span>)}
						</div>
						<h3 class="news__title">{item.title}</h3>
						<p class="news__desc">{item.excerpt}</p>
					</div>
				</a>
			))}
		</div>
		{featured && (
			<a href={`/news/${featured.slug}`} class="news__featured">
				<div class="news__media">
					<div class="news__img" style={`background-image:url('${featuredImage}')`}></div>
				</div>
				<div class="news__content">
					<div class="news__tags">
						<span class="news__category">{featured.category}</span>
						{featured.tags.map((tag) => <span class="news__tag">{tag}</span>)}
					</div>
					<h3 class="news__title">{featured.title}</h3>
					<p class="news__desc">{featured.excerpt}</p>
				</div>
			</a>
		)}
	</div>
</Section>

<style lang="less">
.news {
	display: grid;
	grid-template-columns: 1fr 1fr;
	align-items: stretch;
	gap: 40px;
}

.news__list {
	display: flex;
	flex-direction: column;
	gap: 40px;
	border-right: var(--border-width) solid var(--color-black-50);
	counter-reset: item;
}

.news__item {
	display: flex;
	align-items: flex-start;
	gap: 20px;
	padding-right: 20px;
	counter-increment: item;
	transition: padding-left .2s var(--ease);
	&::before {
		content: counter(item);
		flex: 0 0 32px;
		font-size: 64px;
		line-height: 78px;
		color: rgba(0, 0, 0, 0.2);
		transition: color .2s;
	}
	&:hover {
		padding-left: 6px;
		&::before {
			color: var(--color-red);
		}
		.news__title {
			color: var(--color-red);
		}
	}
}

.news__featured {
	display: flex;
	flex-direction: column;
	gap: 30px;
	&:hover {
		.news__img {
			transform: scale(1.06);
		}
		.news__title {
			color: var(--color-red);
		}
	}
}

.news__media {
	flex: 1;
	position: relative;
	overflow: hidden;
	border-radius: var(--border-radius-25);
	aspect-ratio: 16/10;
}

.news__img {
	position: absolute;
	inset: 0;
	background-size: cover;
	background-position: center;
	transition: transform .6s var(--ease);
}

// Shared by the list items and the featured news.
.news__content {
	display: grid;
	gap: 10px;
	min-width: 0;
}

.news__tags {
	display: flex;
	gap: 20px;
	font-weight: 300;
	font-size: 14px;
	line-height: 17px;
	opacity: 0.5;
}

.news__category {
	font-weight: 700;
	&::after {
		content: '';
		border-right: var(--border-width) solid var(--color-black-50);
		margin-left: 20px;
	}
}

.news__title {
	font-weight: 500;
	font-size: 20px;
	line-height: 24px;
	font-style: italic;
}

.news__desc {
	margin: 12px 0;
	font-size: 16px;
	line-height: 20px;
	color: var(--color-black-50);
}
</style>
