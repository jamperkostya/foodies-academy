---
import Icon from "../ui/Icon.astro";
import Stars from "../ui/Stars.astro";

interface Props {
	views: number;
	likes: number;
	comments: number;
	rating: number;
}

const { views, likes, comments, rating } = Astro.props;
---

<div class="hero-card__stats gap-12 grid">
	<div class="flex gap-12 flex-center">
		<span class="views flex gap-3"><Icon name="views" width={16} height={16} />{views}</span>
		<span class="likes flex gap-3"><Icon name="like" width={16} height={16} />{likes}</span>
	</div>
	<div class="hero-card__rating flex gap-5 flex-center">
		<span class="flex gap-3"><Icon name="comment" width={16} height={16} />{comments}</span>
		<Stars rating={rating} />
	</div>
</div>
