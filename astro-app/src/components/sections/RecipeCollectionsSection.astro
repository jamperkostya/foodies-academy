---
import Section from "../layout/Section.astro";
import CollectionCard from "../collections/CollectionCard.astro";
import type { RecipeCollection } from "../../types/recipeCollection";

interface Props {
	collections: RecipeCollection[];
}

const { collections } = Astro.props;
---
<Section>
	<slot name="title" slot="title" />
	<div class="collections">
		{collections.map((collection) => (
			<CollectionCard collection={collection} />
		))}
	</div>
</Section>

<style lang="less">
.collections {
	display: grid;
	grid-template-columns: 1fr 1fr 1fr 1fr;
	gap: 20px;
	@media (max-width: 860px) {
		grid-template-columns: 1fr 1fr;
		gap: 14px;
	}
	// Room for the cards' hover lift and shadow, as in the carousels.
	padding: 20px 0 56px;
	margin: -20px 0 -56px;
}
</style>
