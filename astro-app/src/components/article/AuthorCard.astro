---
// Author in the article sidebar. With `href` the button is a link
// ("Профиль автора"), without it a plain button ("Подписаться").
import SidebarCard from "./SidebarCard.astro";
import Avatar from "../ui/Avatar.astro";

interface Props {
	name: string;
	// Photo; without it the avatar shows initials.
	avatar?: string;
	info: string;
	buttonLabel: string;
	href?: string;
}

const { name, avatar, info, buttonLabel, href } = Astro.props;
---
<SidebarCard class="author-card">
	{/* With a profile, the photo and the name lead there too, not only the button. */}
	{href ? (
		<a href={href} class="author-card__link">
			<Avatar name={name} src={avatar} size="lg" />
			<strong class="author-card__name">{name}</strong>
		</a>
	) : (
		<Fragment>
			<Avatar name={name} src={avatar} size="lg" />
			<strong class="author-card__name">{name}</strong>
		</Fragment>
	)}
	<span class="author-card__info">{info}</span>
	{href
		? <a href={href} class="btn btn--secondary author-card__btn">{buttonLabel}</a>
		: <button type="button" class="btn btn--secondary author-card__btn">{buttonLabel}</button>}
</SidebarCard>

<style lang="less">
// The root element is SidebarCard's, outside this component's scope.
:global(.author-card) {
	text-align: center;
}
.author-card {
	&__link {
		display: inline-block;
		transition: color .15s;
		&:hover {
			color: var(--color-red);
		}
	}
	&__name {
		display: block;
		font-size: 15px;
		margin: 12px 0 2px;
	}
	&__info {
		display: block;
		font-size: 12px;
		color: var(--color-grey);
		margin-bottom: 16px;
	}
	&__btn {
		width: 100%;
		margin-bottom: 0;
	}
}
</style>
