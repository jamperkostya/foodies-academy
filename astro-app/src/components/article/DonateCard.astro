---
// "Угостить автора кофе" under a recipe: plain links to the donation pages, no third-party
// widget script, so the static page stays fast.
const LINKS = [
	{ label: "Buy Me a Coffee", href: "https://buymeacoffee.com/jamper", modifier: "bmc" },
	// monobank jar: takes any Ukrainian card and Apple/Google Pay without exposing a card number.
	{ label: "Монобанк", href: "https://send.monobank.ua/jar/8NjMxea8qQ", modifier: "mono" },
];
---
<div class="donate-card flex gap-15 items-center no-print">
	<span class="donate-card__title">Понравился рецепт? Угостите нас кофе ☕</span>
	<div class="flex gap-10">
		{LINKS.map(({ label, href, modifier }) => (
			<a href={href} class:list={["donate-card__link", `donate-card__link--${modifier}`]} target="_blank" rel="noopener">{label}</a>
		))}
	</div>
</div>

<style lang="less">
.donate-card {
	flex-wrap: wrap;
	padding: 20px 24px;
	margin-bottom: 40px;
	background: var(--color-light-grey);
	border-radius: var(--border-radius-25);
	&__title {
		font-weight: 700;
		font-size: 16px;
		margin-right: auto;
	}
	&__link {
		padding: 10px 18px;
		border-radius: var(--border-radius-1000);
		font-weight: 700;
		transition: transform .15s, box-shadow .15s;
		&:hover {
			transform: translateY(-2px);
			box-shadow: 0 5px 10px rgba(0, 0, 0, .15);
		}
	}
	// Brand colours of the services, so people recognise the button.
	&__link--bmc {
		background: #ffdd00;
		color: #000;
	}
	&__link--mono {
		background: #000;
		color: #fff;
	}
}
</style>
