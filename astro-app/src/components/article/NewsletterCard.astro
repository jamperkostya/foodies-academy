---
// Newsletter sign-up in the article sidebar. Sent to Laravel → Contact Form 7 (see
// scripts/subscribe.ts); on success the form is swapped for the message.
import SidebarCard from "./SidebarCard.astro";

interface Props {
	title: string;
	text?: string;
}

const { title, text = "Раз в неделю — только лучшее, без спама." } = Astro.props;
const PUBLIC_API_URL = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8000/api";
---
<SidebarCard title={title} accent>
	<p class="newsletter-card__text">{text}</p>
	<form class="newsletter-card__form" data-subscribe={`${PUBLIC_API_URL}/subscribe`} data-list="newsletter">
		<input class="newsletter-card__input" type="text" name="name" placeholder="Имя" aria-label="Имя" autocomplete="given-name" required>
		<input class="newsletter-card__input" type="email" name="email" placeholder="E-mail" aria-label="E-mail" autocomplete="email" required>
		<button type="submit" class="btn newsletter-card__btn">Подписаться</button>
	</form>
	<p class="newsletter-card__success" data-subscribe-done hidden><strong>Готово!</strong> Первое письмо придёт в понедельник.</p>
</SidebarCard>

<script>
	import "../../scripts/subscribe";
</script>

<style lang="less">
.newsletter-card {
	&__text {
		font-size: 13px;
		color: var(--color-grey-dark);
		margin-bottom: 16px;
	}
	&__input {
		width: 100%;
		padding: 12px 16px;
		border-radius: var(--border-radius-1000);
		border: var(--border-width) solid var(--color-border-search-form);
		margin-bottom: 10px;
		font-family: inherit;
		font-size: 13px;
		outline: none;
		&:focus {
			border-color: var(--color-red);
		}
	}
	&__btn {
		width: 100%;
		padding: 14px 20px;
	}
	&__success {
		font-size: 14px;
	}
}
</style>
