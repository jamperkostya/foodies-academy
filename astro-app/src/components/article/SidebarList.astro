---
// "Похожие рецепты" / "Похожие лайфхаки" in the article sidebar.
import SidebarCard from "./SidebarCard.astro";

interface Item {
	title: string;
	// Small line under the title, e.g. "25 мин · Основные блюда".
	meta: string;
	image: string;
	href: string;
}

interface Props {
	title: string;
	items: Item[];
}

const { title, items } = Astro.props;
---
<SidebarCard title={title}>
	<ul class="sidebar-list flex">
		{items.map((item) => (
			<li class="sidebar-list__item">
				<a class="sidebar-list__link flex gap-12 items-center" href={item.href}>
					<span class="sidebar-list__img" style={`background-image: url('${item.image}')`}></span>
					<span>
						<strong class="sidebar-list__title">{item.title}</strong>
						<small class="sidebar-list__meta">{item.meta}</small>
					</span>
				</a>
			</li>
		))}
	</ul>
</SidebarCard>

<style lang="less">
.sidebar-list {
	flex-direction: column;
	gap: 14px;
	&__img {
		width: 52px;
		height: 52px;
		border-radius: var(--border-radius-10);
		background-size: cover;
		background-position: center;
		flex-shrink: 0;
	}
	&__title {
		display: block;
		font-size: 13px;
		line-height: 1.3;
		transition: color .15s;
	}
	&__link:hover &__title {
		color: var(--color-red);
	}
	&__meta {
		display: block;
		font-size: 11px;
		color: var(--color-grey);
		margin-top: 2px;
	}
}
</style>
