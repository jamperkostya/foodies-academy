---
// Review form and list: recipe reviews (withRating) or lifehack comments.
// A posted review is added to the top of the list; nothing is sent anywhere yet.
import ReviewItem from "./ReviewItem.astro";
import type { Review } from "../../types/review";

interface Props {
	reviews: Review[];
	withRating?: boolean;
	formTitle?: string;
	placeholder?: string;
	submitLabel?: string;
	successMessage?: string;
}

const {
	reviews,
	withRating = false,
	formTitle = "Оставить отзыв",
	placeholder = "Расскажите, как получилось...",
	submitLabel = "Опубликовать",
	successMessage = "Спасибо за отзыв!",
} = Astro.props;

const starLabels = ["1 звезда", "2 звезды", "3 звезды", "4 звезды", "5 звёзд"];
---
<div class="reviews" data-success={successMessage}>
	<form class="review-form no-print" novalidate>
		<h3 class="review-form__title">{formTitle}</h3>
		{withRating && (
			<div class="review-form__rating flex gap-5" role="group" aria-label="Ваша оценка">
				{starLabels.map((label) => (
					<button type="button" class="review-form__star" aria-label={label} aria-pressed="false">★</button>
				))}
			</div>
		)}
		<input class="review-form__field" type="text" name="name" placeholder="Ваше имя" aria-label="Ваше имя" required>
		<textarea class="review-form__field" name="comment" rows="3" placeholder={placeholder} aria-label={formTitle} required></textarea>
		<button type="submit" class="btn">{submitLabel}</button>
	</form>

	<div class="reviews__list flex">
		{reviews.map((review) => <ReviewItem review={review} />)}
	</div>

	{/* Cloned for each posted review, so it gets the same markup and scoped styles. */}
	<template class="reviews__template">
		<ReviewItem review={{ name: "", date: "Только что", text: "", rating: withRating ? 0 : undefined }} isNew />
	</template>
</div>

<script>
	import { showToast } from "../../scripts/toast";
	import { initials } from "../../utils/initials";

	document.querySelectorAll<HTMLElement>(".reviews").forEach((root) => {
		const form = root.querySelector<HTMLFormElement>(".review-form")!;
		const list = root.querySelector(".reviews__list")!;
		const template = root.querySelector<HTMLTemplateElement>(".reviews__template")!;
		const stars = [...form.querySelectorAll<HTMLButtonElement>(".review-form__star")];
		const withRating = stars.length > 0;
		let rating = 0;

		const paintStars = (value: number) => stars.forEach((star, i) => star.classList.toggle("is-filled", i < value));
		const setRating = (value: number) => {
			rating = value;
			stars.forEach((star, i) => star.setAttribute("aria-pressed", String(i === value - 1)));
			paintStars(value);
		};

		stars.forEach((star, i) => {
			star.addEventListener("mouseenter", () => paintStars(i + 1));
			star.addEventListener("click", () => setRating(i + 1));
		});
		form.querySelector(".review-form__rating")?.addEventListener("mouseleave", () => paintStars(rating));

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			const data = new FormData(form);
			const name = String(data.get("name") ?? "").trim();
			const text = String(data.get("comment") ?? "").trim();

			if (!name || !text || (withRating && !rating)) {
				showToast(withRating ? "Заполните имя, отзыв и поставьте оценку" : "Заполните имя и комментарий");
				return;
			}

			// User text only ever goes in through textContent.
			const review = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
			review.querySelector(".avatar")!.textContent = initials(name);
			review.querySelector(".review__name")!.textContent = name;
			review.querySelector(".review__text")!.textContent = text;
			review.querySelector<HTMLElement>(".stars")?.style.setProperty("--stars-fill", `${(rating / 5) * 100}%`);
			list.prepend(review);

			form.reset();
			setRating(0);
			showToast(root.dataset.success!);
		});
	});
</script>

<style lang="less">
.reviews__list {
	flex-direction: column;
	gap: 24px;
}

.review-form {
	background: var(--color-light-grey);
	border-radius: var(--border-radius-25);
	padding: 24px;
	margin-bottom: 32px;
	&__title {
		font-size: 16px;
		margin-bottom: 16px;
	}
	&__rating {
		margin-bottom: 14px;
	}
	&__star {
		background: none;
		border: none;
		font-size: 26px;
		line-height: 1;
		color: var(--color-grey);
		cursor: pointer;
		transition: color .1s, transform .1s;
		&:hover {
			transform: scale(1.15);
		}
		&.is-filled {
			color: var(--color-red);
		}
	}
	&__field {
		display: block;
		width: 100%;
		padding: 12px 16px;
		border-radius: var(--border-radius-10);
		border: var(--border-width) solid var(--color-border-search-form);
		background: var(--color-white);
		font-family: inherit;
		font-size: 14px;
		margin-bottom: 12px;
		outline: none;
		resize: vertical;
		&:focus {
			border-color: var(--color-red);
		}
	}
}
</style>
