---
// Text written in the WordPress editor (a page's content), with typography for headings,
// lists, quotes, links and images.
interface Props {
	// HTML from our own WordPress, prepared by Laravel (App\Support\WpHtml).
	html: string;
	class?: string;
}

const { html, class: className } = Astro.props;
---
<div class:list={["page-content", className]} set:html={html} />

<style lang="less">
.page-content {
	max-width: 820px;
	font-size: 17px;
	line-height: 1.65;
	color: var(--color-grey-dark);
	overflow-wrap: anywhere;
	:global(> * + *) {
		margin-top: 16px;
	}
	:global(h2), :global(h3), :global(h4) {
		margin-top: 36px;
		line-height: 1.25;
		color: var(--color-black);
	}
	:global(h2) {
		font-size: 28px;
		@media (max-width: 640px) {
			font-size: 23px;
		}
	}
	:global(h3) {
		font-size: 21px;
	}
	:global(> :first-child) {
		margin-top: 0;
	}
	:global(ul), :global(ol) {
		display: grid;
		gap: 10px;
		padding-left: 1.4em;
	}
	:global(ul) {
		list-style: disc;
	}
	:global(ol) {
		list-style: decimal;
	}
	:global(li::marker) {
		color: var(--color-red);
		font-weight: 700;
	}
	:global(blockquote) {
		padding: 20px 26px;
		border-left: 4px solid var(--color-red);
		border-radius: var(--border-radius-10);
		background: var(--color-light-grey);
		font-size: 19px;
		font-style: italic;
		color: var(--color-black);
	}
	:global(a) {
		color: var(--color-red);
		text-decoration: underline;
	}
	:global(img) {
		max-width: 100%;
		height: auto;
		border-radius: var(--border-radius-25);
	}
	:global(strong) {
		color: var(--color-black);
	}
	:global(table) {
		width: 100%;
		display: block;
		overflow-x: auto;
	}
	:global(td), :global(th) {
		padding: 8px 12px;
		border: var(--border-width) solid var(--color-border-search-form);
	}
}
</style>
