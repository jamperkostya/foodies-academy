---
import Icon from "../ui/Icon.astro";
import Stars from "../ui/Stars.astro";

interface Props {
	views?: number;
	likes?: number;
	comments?: number;
	rating: number;
}

const { views, likes, comments, rating } = Astro.props;
---

<div class="video-stats gap-12 grid">
	{/* Ternaries, not `views && …`: that would print a bare "0". The row
	    itself is skipped when both are empty, so it leaves no gap behind. */}
	{views || likes ? (
		<div class="video-stats__row flex gap-12 items-center">
			{views ? <span class="video-stats__item flex gap-3"><Icon name="views" width={16} height={16} />{views}</span> : null}
			{likes ? <span class="video-stats__item flex gap-3"><Icon name="like" width={16} height={16} />{likes}</span> : null}
		</div>
	) : null}
	<div class="video-stats__rating flex gap-5 flex-center">
		{comments ? <span class="video-stats__item flex gap-3"><Icon name="comment" width={16} height={16} />{comments}</span> : null}
		<Stars rating={rating} />
	</div>
</div>

<style lang="less">
// Each row right-aligned; VideoCard puts the block on the card's right edge.
.video-stats {
	justify-items: end;
}
</style>
