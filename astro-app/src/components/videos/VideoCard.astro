---
import HeroCard from "../sections/HeroCard.astro";
import type { Video } from "../../types/video";

interface Props {
	video: Video;
}

const { video } = Astro.props;
---
{/* Same card as the tall video card in the hero, so the two never drift apart. */}
<HeroCard
	href={`/video/${video.slug}`}
	size="tall"
	image={video.image}
	title={video.title}
	likes={video.likes}
	comments={video.comments}
	rating={video.rating}
	videoId={video.videoId}
	groups={[video.category]}
/>