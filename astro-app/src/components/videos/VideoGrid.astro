---
import Icon from "../ui/Icon.astro";
import Filters from "../ui/Filters.astro";
import VideoCard from "./VideoCard.astro";
import type { Video } from "../../types/video";

interface Props {
	videos: Video[];
	href?: string;
}

const { videos, href } = Astro.props;

// Filters come from the data itself, so a group never shows up empty.
const groups = [...new Set(videos.map((video) => video.category))];
---
<div class="video-grid">
	<Filters groups={groups} href={href} />
	<div class="carousel carousel--videos">
		<div class="carousel__track">
			{videos.map((video) => (
				<VideoCard video={video} />
			))}
		</div>
		<button class="carousel__arrow carousel__arrow--prev" aria-label="Назад">
			<Icon name="arrow-slider" width={12} height={10} />
		</button>
		<button class="carousel__arrow carousel__arrow--next" aria-label="Вперёд">
			<Icon name="arrow-slider" width={12} height={10} />
		</button>
	</div>
	<div class="carousel__dots"></div>
</div>

<style lang="less">
@import "../../styles/carousel.less";

.carousel--videos {
	--gap: 18px;
	--per-view: 5;

	position: relative;
	// Lets the track measure the carousel's (= container's) width in cqw.
	container-type: inline-size;

	@media (max-width: 1200px) {
		--per-view: 4;
	}
	@media (max-width: 860px) {
		--per-view: 3;
	}
	@media (max-width: 640px) {
		--per-view: 1.6;
	}

	.carousel__track {
		display: flex;
		gap: var(--gap);
		overflow-x: auto;
		overflow-y: clip;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
		overflow-clip-margin: 40px;
		padding: 20px 0 56px;
		margin: -20px 0 -56px;

		// full-bleed below 1500px, same technique as .carousel--categories.
		@media (max-width: 1499px) {
			--bleed: calc(50vw - 50cqw);
			margin-left: calc(-1 * var(--bleed));
			margin-right: calc(-1 * var(--bleed));
			padding-left: var(--bleed);
			padding-right: var(--bleed);
			scroll-padding-inline: var(--bleed);
		}

		// The card is HeroCard's tall variant; only its size differs here —
		// fit --per-view columns instead of the hero's fixed 640x460.
		// The card is only ~250px wide here (the hero's is 640px), so the
		// padding and title are scaled down to keep long words inside it.
		:global(.video-card) {
			flex: 0 0 calc((100% - var(--gap) * (var(--per-view) - 1)) / var(--per-view));
			height: auto;
			aspect-ratio: 3/4.3;
			padding: 20px;
			transition: transform .25s var(--ease), box-shadow .25s var(--ease);
			&:hover {
				transform: translateY(-6px);
				box-shadow: 0 20px 34px rgba(29,27,32,.2);
			}
			&:active {
				transform: translateY(-2px) scale(.98);
			}
		}
		:global(.video-card__title) {
			font-size: 24px;
			line-height: 29px;
			// Still too narrow for the odd long word ("Неаполитанская").
			hyphens: auto;
			overflow-wrap: break-word;
		}
	}
}
</style>
<script>
	import { initFilterableCarousel } from "../../scripts/filterableCarousel";

	document.querySelectorAll<HTMLElement>(".video-grid").forEach(initFilterableCarousel);
</script>
