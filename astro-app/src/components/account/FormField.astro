---
// Labelled input with a place for the server's error (filled by scripts/accountForm.ts).
interface Props {
	name: string;
	label: string;
	type?: string;
	autocomplete?: string;
	required?: boolean;
	minlength?: number;
	value?: string;
	multiline?: boolean;
	hint?: string;
}

const { name, label, type = "text", autocomplete, required = false, minlength, value, multiline = false, hint } = Astro.props;
const id = `field-${name}`;
---
<div class="form-field" data-field={name}>
	<label class="form-field__label" for={id}>{label}</label>
	{multiline
		? <textarea class="form-field__input form-field__input--multiline" id={id} name={name} rows="4">{value}</textarea>
		: <input class="form-field__input" id={id} name={name} type={type} autocomplete={autocomplete} required={required} minlength={minlength} value={value} />}
	{hint && <p class="form-field__hint">{hint}</p>}
	<p class="form-field__error" role="alert" hidden></p>
</div>

<style lang="less">
.form-field {
	margin-bottom: 16px;
	&__label {
		display: block;
		margin-bottom: 6px;
		font-size: 14px;
		font-weight: 700;
	}
	&__input {
		display: block;
		width: 100%;
		padding: 12px 16px;
		border-radius: var(--border-radius-10);
		border: var(--border-width) solid var(--color-border-search-form);
		background: var(--color-white);
		font: inherit;
		font-size: 15px;
		outline: none;
		&:focus {
			border-color: var(--color-red);
		}
		&--multiline {
			resize: vertical;
		}
	}
	&.is-invalid &__input {
		border-color: var(--color-red);
	}
	&__hint {
		margin-top: 4px;
		font-size: 12px;
		color: var(--color-grey);
	}
	&__error {
		margin-top: 4px;
		font-size: 13px;
		color: var(--color-red);
	}
}
</style>
