---
import Icon from "../ui/Icon.astro";
import Filters from "../ui/Filters.astro";
import RecipeCard from '../recipes/RecipeCard.astro';
import type { Recipe } from "../../types/recipe";

interface Props {
  recipes: Recipe[];
  // Turns on the filters row: which filter groups a recipe belongs to.
  groupsOf?: (recipe: Recipe) => string[];
  href?: string;
  trackId?: string;
}

const { recipes, groupsOf, href, trackId } = Astro.props;

// Filters come from the data itself, so a group never shows up empty.
const groups = groupsOf && [...new Set(recipes.flatMap(groupsOf))];
---

<div class="recipe-grid">
	{groups && <Filters groups={groups} href={href} />}
	<div class="carousel carousel--recipes">
		<div class="carousel__track" id={trackId}>
			{recipes.map((recipe) => (
				<RecipeCard recipe={recipe} groups={groupsOf?.(recipe)} />
			))}
		</div>
		<button class="carousel__arrow carousel__arrow--prev" aria-label="Назад">
			<Icon name="arrow-slider" width={12} height={10} />
		</button>
		<button class="carousel__arrow carousel__arrow--next" aria-label="Вперёд">
			<Icon name="arrow-slider" width={12} height={10} />
		</button>
	</div>
	<div class="carousel__dots"></div>
</div>

<style lang="less">
	@import "./RecipeGrid.less";
</style>

<script>
	import { initFilterableCarousel } from "../../scripts/filterableCarousel";

	// A page can render several recipe carousels (top 5, new, by ingredient…),
	// so each one gets its own instance instead of relying on a hardcoded id.
	document.querySelectorAll<HTMLElement>(".recipe-grid").forEach(initFilterableCarousel);
</script>
