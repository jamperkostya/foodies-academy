---
import Icon from "../ui/Icon.astro";
import RecipeCard from '../recipes/RecipeCard.astro';
import type { Recipe } from "../../types/recipe";

interface Props {
  recipes: Recipe[];
  trackId?: string;
}

const { recipes, trackId } = Astro.props;
---

<div class="carousel carousel--recipes">
	<div class="carousel__track" id={trackId}>
		{recipes.map((recipe) => (
			<RecipeCard recipe={recipe} />
		))}
	</div>
	<button class="carousel__arrow carousel__arrow--prev" aria-label="Назад">
		<Icon name="arrow-slider" width={12} height={10} />
	</button>
	<button class="carousel__arrow carousel__arrow--next" aria-label="Вперёд">
		<Icon name="arrow-slider" width={12} height={10} />
	</button>
</div>
<div class="carousel__dots"></div>

<style lang="less">
	@import "./RecipeGrid.less";
</style>

<script>
	import { initDragCarousel } from "../../scripts/dragCarousel";

	// A page can render several recipe carousels (top 5, new, by ingredient…),
	// so every ".carousel--recipes" on the page gets its own instance instead
	// of relying on a single hardcoded id.
	document.querySelectorAll<HTMLElement>(".carousel--recipes").forEach(initDragCarousel);
</script>
