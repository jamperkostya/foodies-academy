---
import Icon from "../ui/Icon.astro";

// The API sends counters as short strings ("940", "1.2K"), mock data as numbers.
interface Props {
	views?: string | number;
	likes?: string | number;
	comments?: string | number;
	time?: string | number;
}

const { views, likes, comments, time } = Astro.props;

// Hide a stat when it is missing, empty or zero.
const has = (value?: string | number) => Boolean(value) && value !== '0';
---
<div class="recipe-stats">
	<span class="recipe-stats__item flex gap-3"><Icon name="comment" width={16} height={16} />{comments}</span>
	{has(likes) && <span class="recipe-stats__item flex gap-3"><Icon name="like" width={16} height={16} />{likes}</span>}
	{has(views) && <span class="recipe-stats__item flex gap-3"><Icon name="views" width={16} height={16} />{views}</span>}
	{has(time) && <span class="recipe-stats__item recipe-stats__item--time flex gap-3"><Icon name="clock" width={16} height={16} />{time}</span>}
</div>

<style lang="less">
.recipe-stats {
	display: flex;
	border-top: var(--border-width) solid var(--color-black-20);
	padding-top: 13px;
	font-weight: 300;
	font-size: 14px;
	line-height: 17px;
	color: var(--color-grey);
	justify-content: space-between;
	gap: 5px;
}

.recipe-stats__item--time::before {
	content: '';
	border-left: var(--border-width) solid var(--color-grey);
	margin-right: 5px;
}
</style>
