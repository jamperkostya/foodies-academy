---
import { Image } from "astro:assets";
import Icon from "../ui/Icon.astro";
import logo from "../../assets/images/logotype.png";
import { footerColumns } from "../../data/menu";
---

<footer class="footer container no-print">
	<div class="footer__top">
		<div class="footer__brand">
			<a href="/" class="footer__logo">
				<Image src={logo} alt="Foodies" width={242} height={81} />
			</a>
			<p class="footer__desc">Академия Гурмэ – это рецепты, написанные, созданные, и проверенные поварами для поваров.</p>
			<div class="footer__social">
				<a href="#" class="footer__social-link" aria-label="X"><Icon name="social-x" width={24} height={24} /></a>
				<a href="#" class="footer__social-link" aria-label="Facebook"><Icon name="social-facebook" width={24} height={24} /></a>
				<a href="#" class="footer__social-link" aria-label="LinkedIn"><Icon name="social-linkedin" width={24} height={24} /></a>
				<a href="#" class="footer__social-link" aria-label="Instagram"><Icon name="social-instagram" width={24} height={24} /></a>
				<a href="#" class="footer__social-link" aria-label="Telegram"><Icon name="social-telegram" width={24} height={24} /></a>
			</div>
		</div>

		<nav class="footer__cols" aria-label="Дополнительная навигация">
			{footerColumns.map((column) => (
				<div class="footer__col">
					{column.href
						? <a href={column.href} class="footer__col-header">{column.title}</a>
						: <span class="footer__col-header">{column.title}</span>}
					<ul class="footer__list">
						{column.items.map((item) => (
							<li class="footer__item"><a href={item.href} class="footer__link">{item.title}</a></li>
						))}
					</ul>
				</div>
			))}
		</nav>
	</div>
	
	<div class="footer__bottom">
		<div class="footer__countries">
			Мы в других странах:
			<a href="#" class="footer__country">Италия</a><a href="#" class="footer__country">Швеция</a><a href="#" class="footer__country">Великобритания</a><a href="#" class="footer__country">Испания</a>
		</div>
		<div class="footer__legal">
			<a href="/privacy-policy" class="footer__legal-link">Политика конфиденциальности</a>
			<a href="/terms" class="footer__legal-link">Правила использования</a>
			<a href="/contacts" class="footer__legal-link">Контакты</a>
		</div>
	</div>
</footer>

<style lang="less">
	@import "./Footer.less";
</style>

