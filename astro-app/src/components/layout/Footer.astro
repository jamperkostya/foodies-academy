---
import { Image } from "astro:assets";
import Icon from "../ui/Icon.astro";
import logo from "../../assets/images/logotype.png";
import { footerColumns } from "../../data/menu";

const SOCIAL = [
	{ label: "Facebook", icon: "social-facebook", href: "https://www.facebook.com/Foodies.Academy" },
	{ label: "Instagram", icon: "social-instagram", href: "https://www.instagram.com/foodies.academy/" },
	{ label: "Telegram", icon: "social-telegram", href: "https://t.me/foodies_academy" },
	{ label: "YouTube", icon: "social-youtube", href: "https://www.youtube.com/foodies-academy" },
];
---

<footer class="footer container no-print">
	<div class="footer__top">
		<div class="footer__brand">
			<a href="/" class="footer__logo">
				<Image src={logo} alt="Foodies" width={242} height={81} />
			</a>
			<p class="footer__desc">Академия Гурмэ – это рецепты, написанные, созданные, и проверенные поварами для поваров.</p>
			<div class="footer__social">
				{SOCIAL.map(({ label, icon, href }) => (
					<a href={href} class="footer__social-link" aria-label={label} target="_blank" rel="noopener"><Icon name={icon} width={24} height={24} /></a>
				))}
			</div>
		</div>

		<nav class="footer__cols" aria-label="Дополнительная навигация">
			{footerColumns.map((column) => (
				<div class="footer__col">
					{column.href
						? <a href={column.href} class="footer__col-header">{column.title}</a>
						: <span class="footer__col-header">{column.title}</span>}
					<ul class="footer__list">
						{column.items.map((item) => (
							<li class="footer__item"><a href={item.href} class="footer__link">{item.title}</a></li>
						))}
					</ul>
				</div>
			))}
		</nav>
	</div>
</footer>

<style lang="less">
	@import "./Footer.less";
</style>

