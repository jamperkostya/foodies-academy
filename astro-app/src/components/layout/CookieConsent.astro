---
// Asks readers in the EU, the EEA, the UK and Switzerland whether the statistics counters may run
// (SiteCounters.astro decides who and loads them). Only where the counters are: foodies.academy.
import { langOf, t } from "../../i18n";
const lang = langOf(Astro.url);
---
<div class="cookie-consent no-print" role="dialog" aria-live="polite" aria-label={t(lang, "Файлы cookie")} hidden>
	<p class="cookie-consent__text">
		{t(lang, "Мы используем файлы cookie Google Analytics и Яндекс Метрики, чтобы понимать, какие рецепты вам нравятся. Разрешаете?")}
	</p>
	<div class="cookie-consent__actions flex gap-10">
		<button type="button" class="cookie-consent__button btn btn--primary" data-consent="yes">{t(lang, "Разрешить")}</button>
		<button type="button" class="cookie-consent__button btn btn--secondary" data-consent="no">{t(lang, "Отклонить")}</button>
	</div>
</div>

<script>
	type Counters = { needed: boolean; choice: string | null; load: () => void };
	const counters = (window as unknown as { foodiesCounters?: Counters }).foodiesCounters;
	const banner = document.querySelector<HTMLElement>(".cookie-consent");

	if (banner && counters?.needed && !counters.choice) {
		banner.hidden = false;
		banner.addEventListener("click", (event) => {
			const choice = (event.target as HTMLElement).closest<HTMLElement>("[data-consent]")?.dataset.consent;
			if (!choice) return;
			try {
				localStorage.setItem("foodies:consent", choice);
			} catch {
				// Asked again next time.
			}
			if (choice === "yes") counters.load();
			banner.hidden = true;
		});
	}
</script>

<style lang="less">
.cookie-consent {
	position: fixed;
	right: 16px;
	bottom: 16px;
	left: 16px;
	z-index: 1000;
	max-width: 560px;
	margin: 0 auto;
	padding: 18px 20px;
	border-radius: var(--border-radius-25);
	background: var(--color-white);
	box-shadow: 0 20px 36px #1d1b2033;
	&__text {
		margin: 0 0 12px;
		font-size: 14px;
		line-height: 1.5;
	}
	// The site's .btn as it is; a <button> doesn't inherit the page's font by itself.
	&__button {
		font-family: inherit;
		margin: 0;
		cursor: pointer;
	}
}
</style>
