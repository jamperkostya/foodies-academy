---
interface Props {
	// Narrowest a card may get before the grid drops a column.
	minCardWidth: number;
}

const { minCardWidth } = Astro.props;
---
<div class="card-grid grid gap-20" style={`--card-grid-min: ${minCardWidth}px`}>
	<slot />
</div>

<style lang="less">
.card-grid {
	// min() keeps a single column inside narrow screens.
	grid-template-columns: repeat(auto-fill, minmax(min(var(--card-grid-min), 100%), 1fr));
}
</style>
