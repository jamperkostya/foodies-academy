---
interface Props {
	// Symbol id in /images/icons/sprite.svg.
	name: string;
	width?: number;
	height?: number;
}

const { name, width = 24, height = 24 } = Astro.props;
---

<svg width={width} height={height} aria-hidden="true" focusable="false">
	<use href={`/images/icons/sprite.svg#${name}`}></use>
</svg>
