---
interface Props {
	// Symbol id in /images/icons/sprite.svg.
	name: string;
	width?: number;
	height?: number;
	// BEM class from the parent, e.g. "stars__icon". The parent styles it with
	// :global(.stars__icon), since the <svg> is outside its scope.
	class?: string;
}

const { name, width = 24, height = 24, class: className } = Astro.props;
---

<svg class={className} width={width} height={height} aria-hidden="true" focusable="false">
	<use href={`/images/icons/sprite.svg#${name}`}></use>
</svg>
