---
import { initials } from "../../utils/initials";

interface Props {
	// Shown as initials when there is no photo.
	name: string;
	// Photo URL; "" or missing falls back to the initials.
	src?: string;
	size?: "sm" | "md" | "lg" | "xl";
}

const { name, src, size = "md" } = Astro.props;
---
{src
	? <img class:list={["avatar", "avatar--photo", `avatar--${size}`]} src={src} alt="" loading="lazy" />
	: <span class:list={["avatar", `avatar--${size}`]} aria-hidden="true">{initials(name)}</span>}

<style lang="less">
.avatar {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
	border-radius: var(--border-radius-50percents);
	background: var(--color-black);
	color: var(--color-white);
	font-weight: 700;
	&--photo {
		object-fit: cover;
	}
	&--sm {
		width: 26px;
		height: 26px;
		font-size: 10px;
	}
	&--md {
		width: 38px;
		height: 38px;
		font-size: 13px;
	}
	&--lg {
		width: 56px;
		height: 56px;
		font-size: 18px;
	}
	&--xl {
		width: 108px;
		height: 108px;
		font-size: 34px;
	}
}
</style>
