---
import Icon from "./Icon.astro";

interface Props {
	// Out of 5.
	rating: number;
}

const MAX = 5;
const { rating } = Astro.props;
const percent = Math.max(0, Math.min(100, (rating / MAX) * 100));
---

<span class="stars" style={`--stars-fill: ${percent}%`} role="img" aria-label={`Рейтинг ${rating} из ${MAX}`}>
	<span class="stars__track" aria-hidden="true">
		{Array.from({ length: MAX }).map(() => <Icon name="star" width={19} height={19} />)}
	</span>
	<span class="stars__fill" aria-hidden="true">
		{Array.from({ length: MAX }).map(() => <Icon name="star" width={19} height={19} />)}
	</span>
</span>

<style lang="less">
.stars {
	position: relative;
	display: inline-flex;

	&__track,
	&__fill {
		display: flex;

		:global(svg) {
			flex-shrink: 0;
		}
	}

	&__track {
		color: var(--color-grey);
	}

	&__fill {
		position: absolute;
		inset: 0;
		overflow: hidden;
		width: var(--stars-fill);
		color: var(--color-red);
	}
}
</style>
