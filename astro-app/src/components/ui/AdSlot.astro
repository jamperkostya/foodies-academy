---
// Google AdSense unit: responsive display, or in-feed when `layoutKey` is given. Served only on foodies.academy: AdSense doesn't fill other hosts,
// and dev clicks would count as invalid traffic. Elsewhere a placeholder shows where the ad goes.
interface Props {
	// Ad unit ID (data-ad-slot) from AdSense → Ads → By ad unit. Empty: nothing on production.
	unit: string;
	// Hostname the site is built for (astro.config `site`).
	host?: string;
	// In-feed unit's data-ad-layout-key: it sizes itself to the card it sits in.
	layoutKey?: string;
	class?: string;
}

const PRODUCTION_HOST = "foodies.academy";
// Same publisher as public/ads.txt.
const CLIENT = "ca-pub-5409964786388188";

const { unit, host, layoutKey, class: className } = Astro.props;
const live = host === PRODUCTION_HOST;
---

{
	live ? (
		unit && (
			<aside class:list={["ad-slot no-print", { "ad-slot--feed": layoutKey }, className]} aria-label="Реклама">
				{layoutKey ? (
					<ins class="ad-slot__unit" data-ad-client={CLIENT} data-ad-slot={unit} data-ad-format="fluid" data-ad-layout-key={layoutKey} />
				) : (
					<ins class="ad-slot__unit" data-ad-client={CLIENT} data-ad-slot={unit} data-ad-format="auto" data-full-width-responsive="true" />
				)}
			</aside>
		)
	) : (
		<aside class:list={["ad-slot ad-slot--placeholder no-print", { "ad-slot--feed": layoutKey }, className]} aria-hidden="true">
			Реклама
		</aside>
	)
}

<script>
	// Bundled once per page however many units it has. A unit is filled when it comes near the screen:
	// AdSense fails on units hidden by "Показать ещё". push() fills the first unprocessed `ins.adsbygoogle`,
	// so the class goes on right before it.
	const units = document.querySelectorAll<HTMLElement>(".ad-slot__unit");
	if (units.length) {
		const loader = document.createElement("script");
		loader.async = true;
		loader.crossOrigin = "anonymous";
		loader.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${units[0].dataset.adClient}`;
		document.head.append(loader);
		// Looked up on every push: once loaded, AdSense replaces the queue array with its own object.
		const ads = window as unknown as { adsbygoogle?: object[] };
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach(({ isIntersecting, target }) => {
					if (!isIntersecting) return;
					observer.unobserve(target);
					target.classList.add("adsbygoogle");
					(ads.adsbygoogle ||= []).push({});
				});
			},
			{ rootMargin: "300px" }
		);
		units.forEach((unit) => observer.observe(unit));
	}
</script>

<style lang="less">
.ad-slot {
	margin-top: 30px;
	// Space reserved up front so the text doesn't jump when the ad arrives.
	min-height: 280px;
	@media @tablet {
		min-height: 250px;
	}
	&__unit {
		display: block;
	}
	// Inside a card of the grid: the card sets the size.
	&--feed {
		margin-top: 0;
		min-height: 200px;
	}
	&--placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		border: 2px dashed var(--color-grey);
		color: var(--color-grey);
		font-size: 14px;
		text-transform: uppercase;
	}
}
</style>
