---
// Page numbers under a card grid, plus "Показать ещё": it fetches the next page,
// appends its cards to the grid above and switches the address to that page.
import { pageHref } from "../../utils/pagination";

interface Props {
	page: number;
	pages: number;
	// URL of the first page, e.g. "/category/soups".
	base: string;
}

const { page, pages, base } = Astro.props;

// 1 … 4 5 [6] 7 8 … 14: the first and last page, and two on each side of the current one.
const shown = [...new Set([1, page - 2, page - 1, page, page + 1, page + 2, pages])]
	.filter((n) => n >= 1 && n <= pages)
	.sort((a, b) => a - b);
const items = shown.flatMap((n, i) => (i > 0 && n - shown[i - 1] > 1 ? ["…", n] : [n]));
---
{pages > 1 && (
	<div class="pagination" data-pagination>
		{page < pages && (
			<a class="pagination__more btn btn--secondary" href={pageHref(base, page + 1)} data-load-more>Показать ещё</a>
		)}
		<nav class="pagination__pages" aria-label="Страницы">
			{page > 1 && <a class="pagination__link" href={pageHref(base, page - 1)} rel="prev" aria-label="Предыдущая страница">←</a>}
			{items.map((item) =>
				item === "…" ? (
					<span class="pagination__gap">…</span>
				) : item === page ? (
					<span class="pagination__link pagination__link--current" aria-current="page">{item}</span>
				) : (
					<a class="pagination__link" href={pageHref(base, item as number)}>{item}</a>
				),
			)}
			{page < pages && <a class="pagination__link" href={pageHref(base, page + 1)} rel="next" aria-label="Следующая страница">→</a>}
		</nav>
	</div>
)}

<script>
	// Delegated, so the button that arrives with the next page works too.
	document.addEventListener("click", async (event) => {
		const button = (event.target as HTMLElement).closest<HTMLAnchorElement>("[data-load-more]");
		const pagination = button?.closest<HTMLElement>("[data-pagination]");
		const grid = pagination?.parentElement?.querySelector<HTMLElement>(".card-grid");
		if (!button || !pagination || !grid) return;
		event.preventDefault();
		if (button.getAttribute("aria-busy") === "true") return;

		button.setAttribute("aria-busy", "true");
		button.textContent = "Загружаем…";
		try {
			const response = await fetch(button.href);
			if (!response.ok) throw new Error(String(response.status));
			const next = new DOMParser().parseFromString(await response.text(), "text/html");
			const cards = [...(next.querySelector(".card-grid")?.children ?? [])] as HTMLElement[];
			grid.append(...cards);
			grid.dispatchEvent(new CustomEvent("cards:loaded", { detail: cards, bubbles: true }));
			// The next page's own pagination: its button points one page further, its numbers mark it as current.
			const nextPagination = next.querySelector("[data-pagination]");
			if (nextPagination) pagination.replaceWith(nextPagination);
			else pagination.remove();
			// Replace, not push: "Back" leaves the list instead of stepping through
			// addresses whose cards are all still on the page.
			history.replaceState(history.state, "", button.href);
			document.title = next.title;
		} catch {
			// The link still works without JavaScript: open the page instead.
			window.location.href = button.href;
		}
	});
</script>

<style lang="less">
.pagination {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 20px;
	margin-top: 40px;
	&__more[aria-busy="true"] {
		opacity: .6;
		pointer-events: none;
	}
	&__pages {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;
	}
	&__link,
	&__gap {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 40px;
		height: 40px;
		padding: 0 10px;
		border-radius: var(--border-radius-1000);
		font-weight: 600;
		font-size: 14px;
	}
	&__link {
		border: var(--border-width) solid var(--color-black-20);
		transition: background .15s, color .15s, border-color .15s;
		&:hover {
			border-color: var(--color-red);
			color: var(--color-red);
		}
		&--current,
		&--current:hover {
			background: var(--color-red);
			border-color: var(--color-red);
			color: var(--color-white);
		}
	}
	&__gap {
		color: var(--color-grey);
	}
}
</style>
